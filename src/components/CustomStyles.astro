---
// Base Impact branding: Atkinson Hyperlegible (body) + Fraunces (headings)
// Colors mapped from the existing Base Impact design system.
---

<style is:inline>
  :root {
    --aw-font-sans: 'Atkinson Hyperlegible', sans-serif;
    --aw-font-serif: 'Atkinson Hyperlegible', sans-serif;
    --aw-font-heading: 'Fraunces', Georgia, serif;

    --aw-color-primary: rgb(29 78 216);
    --aw-color-secondary: rgb(30 64 175);
    --aw-color-accent: rgb(29 78 216);

    --aw-color-text-heading: rgb(17 24 39);
    --aw-color-text-default: rgb(17 24 39);
    --aw-color-text-muted: rgb(55 65 81);
    --aw-color-bg-page: rgb(247 249 251);

    --aw-color-bg-page-dark: rgb(10 15 26);
  }

  .dark {
    --aw-font-sans: 'Atkinson Hyperlegible', sans-serif;
    --aw-font-serif: 'Atkinson Hyperlegible', sans-serif;
    --aw-font-heading: 'Fraunces', Georgia, serif;

    --aw-color-primary: rgb(96 165 250);
    --aw-color-secondary: rgb(147 197 253);
    --aw-color-accent: rgb(96 165 250);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(226 232 240 / 66%);
    --aw-color-bg-page: rgb(11 18 32);
  }
</style>
