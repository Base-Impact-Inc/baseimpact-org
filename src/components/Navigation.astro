---
// Base Impact navigation — styled to match douglaspc.com Navigation.astro
const findHelp = [
  { href: "/directory", label: "Resource Directory" },
  { href: "/technology-access", label: "Technology Access" },
  { href: "/guide", label: "Resource Guide" },
  { href: "/directory?filter=crisis", label: "Crisis Help (211)" },
];

const about = [
  { href: "/about", label: "About Us" },
  { href: "/purpose", label: "Our Purpose" },
  { href: "/impact", label: "Impact" },
  { href: "/partners", label: "Partners" },
  { href: "/financials", label: "Financials" },
  { href: "/grants", label: "Grants & Funding" },
];

const getInvolved = [
  { href: "/volunteer", label: "Volunteer" },
  { href: "/join", label: "Join Us" },
  { href: "/how-to-help", label: "How to Help" },
  { href: "/donate", label: "Donate" },
];

const resources = [
  { href: "/events", label: "Events" },
  { href: "/photos", label: "Photos" },
  { href: "/programs", label: "Programs" },
  { href: "/grants/ai-toolkit", label: "Grant Toolkit" },
  { href: "/es", label: "Espanol" },
];

const connect = [
  { href: "/contact", label: "Contact" },
  { href: "/feedback", label: "Feedback" },
  { href: "/share-your-story", label: "Share Your Story" },
  { href: "/socials", label: "Socials" },
];

const searchPages = [
  { title: "Home", url: "/", keywords: "home main" },
  { title: "Resource Directory", url: "/directory", keywords: "directory find help resources" },
  { title: "Technology Access", url: "/technology-access", keywords: "technology devices internet" },
  { title: "Resource Guide", url: "/guide", keywords: "guide help" },
  { title: "Stories", url: "/blog", keywords: "blog stories" },
  { title: "About", url: "/about", keywords: "about company" },
  { title: "Contact", url: "/contact", keywords: "contact email phone" },
  { title: "Donate", url: "/donate", keywords: "donate give" },
  { title: "Volunteer", url: "/volunteer", keywords: "volunteer help" },
];
---

<header class="site-header" role="banner">
  <nav class="nav-container" aria-label="Main navigation">
    <a href="/" class="nav-logo">
      <span class="logo-text">Base Impact</span>
    </a>

    <div class="nav-links desktop-nav" role="menubar">
      <div class="nav-dropdown" data-dropdown="findhelp">
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Find Help <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <div class="dropdown-grid">
            {findHelp.map((s) => (
              <a href={s.href} class="dropdown-item" role="menuitem">
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-dropdown" data-dropdown="about">
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          About <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <div class="dropdown-grid">
            {about.map((s) => (
              <a href={s.href} class="dropdown-item" role="menuitem">
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-dropdown" data-dropdown="involved">
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Get Involved <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <div class="dropdown-grid">
            {getInvolved.map((s) => (
              <a href={s.href} class="dropdown-item" role="menuitem">
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/blog" class="nav-link">Stories</a>

      <div class="nav-dropdown" data-dropdown="resources">
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Resources <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <div class="dropdown-grid">
            {resources.map((s) => (
              <a href={s.href} class="dropdown-item" role="menuitem">
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-dropdown" data-dropdown="connect">
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Connect <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <div class="dropdown-grid">
            {connect.map((s) => (
              <a href={s.href} class="dropdown-item" role="menuitem">
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <button class="nav-search-btn" aria-label="Search (Ctrl+K)" title="Search (Ctrl+K)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <a href="/donate" class="btn-primary nav-cta">Donate</a>
    </div>

    <button class="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </nav>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-overlay"></div>
    <div class="mobile-drawer-content">
      <div class="mobile-drawer-header">
        <span class="mobile-drawer-title">Menu</span>
        <button class="mobile-drawer-close" aria-label="Close menu">&#10005;</button>
      </div>

      <div class="mobile-nav-section">
        <a href="/" class="mobile-nav-link">Home</a>
        <a href="/directory" class="mobile-nav-link mobile-highlight">Find Help Near You</a>
        <a href="/blog" class="mobile-nav-link">Stories</a>
        <a href="/donate" class="mobile-nav-link mobile-highlight">Donate</a>
      </div>

      <div class="mobile-nav-section">
        <button class="mobile-nav-group-toggle" aria-expanded="false">
          Find Help <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="mobile-nav-group" hidden>
          {findHelp.map((s) => (
            <a href={s.href} class="mobile-nav-link mobile-nav-sub">{s.label}</a>
          ))}
        </div>
      </div>

      <div class="mobile-nav-section">
        <button class="mobile-nav-group-toggle" aria-expanded="false">
          About <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="mobile-nav-group" hidden>
          {about.map((s) => (
            <a href={s.href} class="mobile-nav-link mobile-nav-sub">{s.label}</a>
          ))}
        </div>
      </div>

      <div class="mobile-nav-section">
        <button class="mobile-nav-group-toggle" aria-expanded="false">
          Get Involved <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="mobile-nav-group" hidden>
          {getInvolved.map((s) => (
            <a href={s.href} class="mobile-nav-link mobile-nav-sub">{s.label}</a>
          ))}
        </div>
      </div>

      <div class="mobile-nav-section">
        <button class="mobile-nav-group-toggle" aria-expanded="false">
          Resources <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="mobile-nav-group" hidden>
          {resources.map((s) => (
            <a href={s.href} class="mobile-nav-link mobile-nav-sub">{s.label}</a>
          ))}
        </div>
      </div>

      <div class="mobile-nav-section">
        <button class="mobile-nav-group-toggle" aria-expanded="false">
          Connect <span class="dropdown-arrow">&#9662;</span>
        </button>
        <div class="mobile-nav-group" hidden>
          {connect.map((s) => (
            <a href={s.href} class="mobile-nav-link mobile-nav-sub">{s.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="search-modal" id="search-modal" aria-hidden="true" role="dialog" aria-label="Search">
    <div class="search-modal-overlay"></div>
    <div class="search-modal-content">
      <div class="search-modal-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input type="search" class="search-modal-input" placeholder="Search pages..." aria-label="Search" />
        <kbd class="search-modal-kbd">ESC</kbd>
      </div>
      <div class="search-modal-results" id="search-results">
        <p class="search-hint">Type to search.</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--color-page); border-bottom: 1px solid var(--color-line); }
  .nav-container { max-width: 1200px; margin: 0 auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .nav-logo { display: flex; align-items: center; gap: 0.625rem; text-decoration: none; color: var(--color-body); font-weight: 700; font-size: 1.125rem; flex-shrink: 0; }
  .logo-text { font-family: var(--font-display, inherit); }
  .desktop-nav { display: flex; align-items: center; gap: 0.25rem; }
  .nav-link { color: var(--color-muted); text-decoration: none; font-size: 0.9375rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; transition: color 0.2s, background 0.2s; }
  .nav-link:hover { color: var(--color-body); background: var(--color-inset); }
  .nav-dropdown { position: relative; }
  .nav-dropdown-trigger { background: none; border: none; color: var(--color-muted); font-size: 0.9375rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; font-family: inherit; transition: color 0.2s, background 0.2s; }
  .nav-dropdown-trigger:hover { color: var(--color-body); background: var(--color-inset); }
  .dropdown-arrow { font-size: 0.75rem; transition: transform 0.2s; }
  .nav-dropdown.open .dropdown-arrow { transform: rotate(180deg); }
  .nav-dropdown-menu { position: absolute; top: 100%; left: 0; min-width: 220px; background: var(--color-card); border: 1px solid var(--color-line); border-radius: 0.75rem; padding: 0.5rem; box-shadow: 0 8px 32px rgba(0,0,0,0.15); opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity 0.2s, transform 0.2s, visibility 0.2s; z-index: 200; }
  .nav-dropdown.open .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .dropdown-grid { display: grid; grid-template-columns: 1fr; gap: 0.125rem; }
  .dropdown-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 0.5rem; color: var(--color-body); text-decoration: none; font-size: 0.875rem; transition: background 0.15s, color 0.15s; }
  .dropdown-item:hover { background: var(--color-inset); }
  .nav-search-btn { background: none; border: 1px solid var(--color-line); color: var(--color-muted); padding: 0.375rem 0.5rem; border-radius: 0.375rem; cursor: pointer; display: flex; align-items: center; transition: border-color 0.2s, color 0.2s; }
  .nav-search-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .search-modal { position: fixed; inset: 0; z-index: 1000; display: none; }
  .search-modal.open { display: flex; align-items: center; justify-content: center; }
  .search-modal-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); }
  .search-modal-content { position: relative; width: 90%; max-width: 600px; background: var(--color-card); border: 1px solid var(--color-line); border-radius: 1rem; overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,0.2); }
  .search-modal-header { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-line); }
  .search-modal-input { flex: 1; background: none; border: none; color: var(--color-body); font-size: 1.125rem; font-family: inherit; outline: none; }
  .search-modal-kbd { background: var(--color-inset); border: 1px solid var(--color-line); border-radius: 0.25rem; padding: 0.125rem 0.5rem; font-size: 0.75rem; color: var(--color-muted); }
  .search-modal-results { padding: 1rem; max-height: 400px; overflow-y: auto; }
  .search-hint { color: var(--color-muted); font-size: 0.875rem; text-align: center; padding: 2rem; }
  .nav-cta { font-size: 0.875rem; padding: 0.5rem 1rem; }
  .mobile-menu-btn { display: none; flex-direction: column; gap: 4px; background: none; border: none; cursor: pointer; padding: 0.5rem; }
  .hamburger-line { width: 24px; height: 2px; background: var(--color-body); border-radius: 1px; transition: transform 0.2s, opacity 0.2s; }
  .mobile-menu-btn.open .hamburger-line:nth-child(1) { transform: rotate(45deg) translate(4px, 4px); }
  .mobile-menu-btn.open .hamburger-line:nth-child(2) { opacity: 0; }
  .mobile-menu-btn.open .hamburger-line:nth-child(3) { transform: rotate(-45deg) translate(4px, -4px); }
  .mobile-drawer { position: fixed; inset: 0; z-index: 200; display: none; }
  .mobile-drawer.open { display: block; }
  .mobile-drawer-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px); }
  .mobile-drawer-content { position: absolute; top: 0; right: 0; width: 320px; max-width: 85vw; height: 100%; background: var(--color-page); border-left: 1px solid var(--color-line); overflow-y: auto; transform: translateX(100%); transition: transform 0.3s ease; padding: 1.5rem; }
  .mobile-drawer.open .mobile-drawer-content { transform: translateX(0); }
  .mobile-drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .mobile-drawer-title { font-size: 1.25rem; font-weight: 700; color: var(--color-body); }
  .mobile-drawer-close { background: none; border: none; color: var(--color-muted); font-size: 1.5rem; cursor: pointer; padding: 0.25rem; }
  .mobile-nav-section { margin-bottom: 1rem; }
  .mobile-nav-link { display: block; padding: 0.625rem 0; color: var(--color-muted); text-decoration: none; font-size: 1rem; border-bottom: 1px solid var(--color-line); transition: color 0.2s; }
  .mobile-nav-link:hover { color: var(--color-accent); }
  .mobile-nav-sub { font-size: 0.9375rem; border-bottom: none; padding: 0.5rem 0; }
  .mobile-nav-group-toggle { width: 100%; background: none; border: none; color: var(--color-body); font-size: 1rem; font-weight: 600; padding: 0.625rem 0; text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-line); font-family: inherit; }
  .mobile-nav-group { padding-left: 1rem; }
  .mobile-highlight { color: var(--color-accent); font-weight: 600; }
  /* Below ~900px the desktop nav no longer fits beside the CTA; use the drawer.
     Above it the desktop menu needs roughly 840px of content width. */
  @media (max-width: 900px) { .desktop-nav { display: none; } .mobile-menu-btn { display: flex; } }
  @media (min-width: 901px) { .mobile-drawer { display: none !important; } }
  .search-result-item { display: block; padding: 0.5rem 0.75rem; border-radius: 0.5rem; color: var(--color-muted); text-decoration: none; font-size: 0.9375rem; transition: background 0.15s; }
  .search-result-item:hover { background: var(--color-inset); color: var(--color-body); }
</style>

<script>
  const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileDrawerClose = document.querySelector('.mobile-drawer-close');
  const mobileDrawerOverlay = document.querySelector('.mobile-drawer-overlay');

  function openMobileMenu() {
    mobileDrawer?.classList.add('open');
    mobileMenuBtn?.classList.add('open');
    mobileMenuBtn?.setAttribute('aria-expanded', 'true');
    mobileDrawer?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeMobileMenu() {
    mobileDrawer?.classList.remove('open');
    mobileMenuBtn?.classList.remove('open');
    mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    mobileDrawer?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  mobileMenuBtn?.addEventListener('click', openMobileMenu);
  mobileDrawerClose?.addEventListener('click', closeMobileMenu);
  mobileDrawerOverlay?.addEventListener('click', closeMobileMenu);

  document.querySelectorAll('.mobile-nav-group-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      const group = btn.nextElementSibling;
      if (group) (group as HTMLElement).hidden = expanded;
      const arrow = btn.querySelector('.dropdown-arrow');
      if (arrow) (arrow as HTMLElement).style.transform = expanded ? '' : 'rotate(180deg)';
    });
  });

  document.querySelectorAll('.nav-dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector('.nav-dropdown-trigger');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('open');
      document.querySelectorAll('.nav-dropdown.open').forEach((d) => {
        if (d !== dropdown) {
          d.classList.remove('open');
          d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
      dropdown.classList.toggle('open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element)?.closest('.nav-dropdown')) {
      document.querySelectorAll('.nav-dropdown.open').forEach((d) => {
        d.classList.remove('open');
        d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMobileMenu();
      document.querySelectorAll('.nav-dropdown.open').forEach((d) => {
        d.classList.remove('open');
        d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      });
      document.getElementById('search-modal')?.classList.remove('open');
    }
  });

  const searchBtn = document.querySelector('.nav-search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchInput = document.querySelector('.search-modal-input') as HTMLInputElement;

  function openSearch() {
    searchModal?.classList.add('open');
    searchInput?.focus();
  }
  function closeSearch() {
    searchModal?.classList.remove('open');
    if (searchInput) searchInput.value = '';
  }
  searchBtn?.addEventListener('click', openSearch);
  document.querySelector('.search-modal-overlay')?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  const searchInputEl = document.querySelector('.search-modal-input');
  searchInputEl?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    const results = document.getElementById('search-results');
    if (!results) return;
    if (!query) {
      results.innerHTML = '<p class="search-hint">Type to search.</p>';
      return;
    }
    const matches = searchPages.filter((p) =>
      p.title.toLowerCase().includes(query) || p.keywords.includes(query)
    );
    if (matches.length === 0) {
      results.innerHTML = '<p class="search-hint">No results found.</p>';
      return;
    }
    results.innerHTML = matches.map((m) =>
      '<a href="' + m.url + '" class="search-result-item">' + m.title + '</a>'
    ).join('');
  });
</script>
