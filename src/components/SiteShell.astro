---
import { getRelativeLocaleUrl } from 'astro:i18n';
---

<div class="site-shell">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-card focus:px-3 focus:py-2">
    Skip to content
  </a>

  <aside class="px-4 py-2 text-center text-sm font-medium" style="color: var(--color-muted);">
    Base Impact Inc. · Pre-filing nonprofit in Scottsmoor, FL
  </aside>

  <header class="sticky top-0 z-40" style="background: var(--color-page);">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-4">
      <a href="/" class="flex min-h-11 min-w-0 items-center gap-2">
        <span class="block font-display text-lg font-semibold leading-none tracking-tight" style="color: var(--color-body);">Base Impact</span>
      </a>

      <nav class="hidden items-center gap-6 md:flex" aria-label="Primary" id="desktop-nav">
        <!-- Populated by script -->
      </nav>

      <div class="flex items-center gap-3">
        <button type="button" id="triage-btn" class="flex min-h-11 items-center gap-1 px-3 text-sm font-semibold" style="background: var(--color-fill); color: var(--color-on-fill);">
          Need help now
        </button>
        <button type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu"
          aria-label="Open menu"
          onclick="var m=document.getElementById('mobile-menu'),b=document.getElementById('mobile-menu-backdrop');if(m){var open=m.classList.contains('hidden');m.classList.toggle('hidden',!open);if(b)b.classList.toggle('hidden',!open);this.setAttribute('aria-expanded',String(open));this.setAttribute('aria-label',open?'Close menu':'Open menu');}"
          class="flex min-h-11 min-w-11 items-center justify-center" style="color: var(--color-body);">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </header>

  <div id="mobile-menu" class="hidden fixed inset-x-0 top-16 z-50" style="background: var(--color-page);" role="dialog" aria-modal="true" aria-label="Site navigation">
    <div id="mobile-menu-backdrop" class="fixed inset-0 bg-black/50 hidden" onclick="document.getElementById('mobile-menu')?.classList.add('hidden');this.classList.add('hidden');document.getElementById('menu-btn')?.setAttribute('aria-expanded','false');document.getElementById('menu-btn')?.setAttribute('aria-label','Open menu');"></div>
    <nav aria-label="Mobile full menu" class="relative mx-auto max-w-6xl px-4 py-3">
      <p class="mb-2 text-sm font-medium" style="color: var(--color-muted);">Navigate</p>
      <ul class="flex flex-col gap-1" id="mobile-nav">
        <!-- Populated by script -->
      </ul>
      <p class="mb-2 mt-4 text-sm font-medium" style="color: var(--color-muted);">More</p>
      <ul class="flex flex-col gap-1" id="mobile-more">
        <!-- Populated by script -->
      </ul>
    </nav>
  </div>

  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-5 sm:py-8 xl:pb-12">
    <slot />
  </main>

  <footer class="px-4 pt-16 pb-12">
      <div class="mx-auto max-w-6xl">
        <p class="font-display text-4xl font-semibold leading-none tracking-tight mb-8" style="color: var(--color-body);">Base Impact</p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" style="color: var(--color-muted);">
          <div>
            <p>Scottsmoor, FL 32775 · Serving communities worldwide</p>
            <p class="mt-2">
              <a href="tel:+13213230999" class="font-medium hover:underline" style="color: var(--color-body);">(321) 323-0999</a>
              · call or text · by appointment only
            </p>
          </div>
          <div class="sm:text-right">
            <p>© {new Date().getFullYear()} Base Impact Inc.</p>
            <p class="mt-1 text-sm">Tip: Use your browser's translate feature for other languages.</p>
            <div class="mt-2 flex gap-4 sm:justify-end">
              <a href="/privacy" class="hover:underline" style="color: var(--color-body);">Privacy</a>
              <a href="/terms" class="hover:underline" style="color: var(--color-body);">Terms</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
</div>

<script>
  const NAV = [
    { to: '/', label: 'Base Impact' },
    { to: '/directory', label: 'Find help' },
    { to: '/about', label: 'About' },
    { to: '/programs', label: 'Programs' },
    { to: '/donate', label: 'Donate' },
  ];
  const MORE = [
    { to: '/events', label: 'Events' },
    { to: '/blog', label: 'Blog' },
    { to: '/photos', label: 'Photos' },
    { to: '/how-to-help', label: 'How to help' },
    { to: '/purpose', label: 'Our purpose' },
    { to: '/join', label: 'Join us' },
    { to: '/donate', label: 'Donate' },
    { to: '/financials', label: 'Financials' },
    { to: '/technology-access', label: 'Technology access' },
    { to: '/grants', label: 'Grants & funding' },
    { to: '/contact', label: 'Contact' },
    { to: '/feedback', label: 'Feedback' },
    { to: '/connect', label: 'Connect' },
    { to: '/socials', label: 'Socials' },
    { to: '/privacy', label: 'Privacy' },
    { to: '/terms', label: 'Terms' },
  ];

  const path = window.location.pathname.replace(/\/$/, '') || '/';

  // Desktop nav
  const desktopNav = document.getElementById('desktop-nav');
  if (desktopNav) {
    NAV.forEach(item => {
      const a = document.createElement('a');
      a.href = item.to;
      a.className = 'flex min-h-11 items-center gap-2 px-1 text-sm font-medium ' +
        (path === item.to ? 'underline underline-offset-4' : 'hover:underline hover:underline-offset-4');
      a.textContent = item.label;
      desktopNav.appendChild(a);
    });
  }

  // Mobile nav
  const mobileNav = document.getElementById('mobile-nav');
  if (mobileNav) {
    NAV.forEach(item => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = item.to;
      a.className = 'flex min-h-12 items-center gap-3 rounded-xl px-3 text-base font-semibold ' +
        (path === item.to ? 'bg-fill text-on-fill' : 'text-body hover:bg-inset');
      a.textContent = item.label;
      a.addEventListener('click', () => { document.getElementById('mobile-menu')?.classList.add('hidden'); });
      li.appendChild(a);
      mobileNav.appendChild(li);
    });
  }

  // Mobile more
  const mobileMore = document.getElementById('mobile-more');
  if (mobileMore) {
    MORE.forEach(item => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = item.to;
      a.className = 'flex min-h-12 items-center rounded-xl px-3 text-base font-semibold ' +
        (path === item.to ? 'bg-fill text-on-fill' : 'text-body hover:bg-inset');
      a.textContent = item.label;
      a.addEventListener('click', () => { document.getElementById('mobile-menu')?.classList.add('hidden'); });
      li.appendChild(a);
      mobileMore.appendChild(li);
    });
  }

  // Mobile menu toggle
  function setupMobileMenu() {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('mobile-menu');
    var backdrop = document.getElementById('mobile-menu-backdrop');
    if (!btn || !menu) return;
    btn.addEventListener('click', function() {
      var open = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !open);
      if (backdrop) backdrop.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    if (backdrop) {
      backdrop.addEventListener('click', function() {
        menu.classList.add('hidden');
        backdrop.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }

  // Triage button (placeholder)
  const triageBtn = document.getElementById('triage-btn');
  if (triageBtn) {
    triageBtn.addEventListener('click', () => {
      // Show emergency help overlay
      const overlay = document.createElement('div');
      overlay.id = 'triage-overlay';
      overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;padding:1rem;';
      overlay.innerHTML = `
        <div style="background:var(--color-card);border-radius:1rem;padding:1.5rem;max-width:400px;width:100%;max-height:90vh;overflow-y:auto;">
          <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:600;margin-bottom:1rem;color:var(--color-body);">Need Help Now?</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            <a href="tel:911" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-critical);color:var(--color-critical);font-weight:600;text-decoration:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call 911 — Emergency
            </a>
            <a href="tel:211" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-caution);color:var(--color-caution);font-weight:600;text-decoration:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call 211 — Find local help
            </a>
            <a href="tel:988" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-caution);color:var(--color-caution);font-weight:600;text-decoration:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Call 988 — Crisis lifeline
            </a>
            <a href="/directory" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-inset);color:var(--color-body);font-weight:600;text-decoration:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              Browse all resources
            </a>
          </div>
          <button type="button" onclick="document.getElementById('triage-overlay').remove()" style="margin-top:1rem;width:100%;padding:0.75rem;border-radius:0.75rem;border:1px solid var(--color-line);background:var(--color-card);color:var(--color-body);font-weight:600;cursor:pointer;">Close</button> <!-- taste-skill-ignore -->
        </div>
      `;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.remove();
      });
    });
  }
</script>

