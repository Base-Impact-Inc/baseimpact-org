---
import { getRelativeLocaleUrl } from 'astro:i18n';
---

<div class="site-shell">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-card focus:px-3 focus:py-2">
    Skip to content
  </a>

  <aside class="px-4 py-2 text-center text-sm font-medium" style="color: var(--color-muted);">
    Base Impact Inc. · EIN 43-2200667 · Florida nonprofit corporation · FDACS registered · Brevard County, FL
  </aside>

  <!-- backdrop-filter must NOT live on this element: it makes the header the
       containing block for the position:fixed mobile menu below, trapping it
       inside the header band. -->
  <header class="sticky top-0 z-40" style="background: rgba(0, 0, 0, 0.92); border-bottom: 1px solid var(--color-line);">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
      <a href="/" class="flex min-h-11 min-w-0 items-center gap-2">
        <span class="block font-display text-xl font-semibold leading-none tracking-tight" style="color: var(--color-body);">Base Impact<span style="color: var(--color-accent);">.</span></span>
      </a>

      <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
              <div class="mega-group">
                <button class="mega-trigger" aria-expanded="false" aria-controls="mega-find-help" min-h-11>
                  Find Help
                  <svg class="mega-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4.5l3 3 3-3"/></svg>
                </button>
                <div class="mega-panel" role="menu" id="mega-find-help">
                  <a href="/directory" role="menuitem" class="min-h-11 flex items-center px-3">Resource Directory</a>
                  <a href="/guide" role="menuitem" class="min-h-11 flex items-center px-3">Resource Guide</a>
                  <a href="/directory?filter=crisis" role="menuitem" class="mega-highlight min-h-11 flex items-center px-3">Crisis Help (211)</a>
                </div>
              </div>

              <div class="mega-group">
                <button class="mega-trigger" aria-expanded="false" aria-controls="mega-programs" min-h-11>
                  Programs
                  <svg class="mega-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4.5l3 3 3-3"/></svg>
                </button>
                <div class="mega-panel" role="menu" id="mega-programs">
                  <a href="/technology-access" role="menuitem" class="min-h-11 flex items-center px-3">Technology Access</a>
                  <a href="/programs/digital-skills" role="menuitem" class="min-h-11 flex items-center px-3">Digital Skills & Job Help</a>
                  <a href="/programs/nonprofit-tech" role="menuitem" class="min-h-11 flex items-center px-3">Tech for Small Nonprofits</a>
                  <a href="/programs/resource-guide" role="menuitem" class="min-h-11 flex items-center px-3">Local Resource Guide</a>
                </div>
              </div>

              <div class="mega-group">
                <button class="mega-trigger" aria-expanded="false" aria-controls="mega-support" min-h-11>
                  Support
                  <svg class="mega-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4.5l3 3 3-3"/></svg>
                </button>
                <div class="mega-panel" role="menu" id="mega-support">
                  <a href="/donate" role="menuitem" class="min-h-11 flex items-center px-3">Donate</a>
                  <a href="/volunteer" role="menuitem" class="min-h-11 flex items-center px-3">Volunteer</a>
                  <a href="/join" role="menuitem" class="min-h-11 flex items-center px-3">Join Us</a>
                  <a href="/how-to-help" role="menuitem" class="min-h-11 flex items-center px-3">How to Help</a>
                </div>
              </div>

              <a href="/about" class="mega-link min-h-11 flex items-center px-3">About</a>
      </nav>

      <div class="flex items-center gap-3">
        <button type="button" id="triage-btn" class="flex min-h-11 items-center gap-1 text-sm font-semibold" style="background: var(--color-fill); color: var(--color-on-fill); border-radius: 999px; padding-inline: 1rem; white-space: nowrap;">
          Need help now
        </button>
        <button type="button" id="menu-btn" class="flex min-h-11 min-w-11 items-center justify-center md:hidden" style="color: var(--color-body);" aria-label="Open menu" aria-expanded="false">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu-backdrop" class="fixed inset-0 z-40 hidden md:hidden" style="background: rgba(0,0,0,0.5);" aria-hidden="true"></div>
    <div id="mobile-menu" class="fixed inset-0 z-50 hidden md:hidden overflow-y-auto" style="background: var(--color-page);" role="dialog" aria-modal="true" aria-label="Site navigation">
      <div class="mx-auto max-w-lg px-6 py-8">
        <div class="flex items-center justify-between mb-6">
          <span class="font-display text-lg font-semibold" style="color: var(--color-body);">Base Impact</span>
          <button type="button" id="mobile-close" class="min-h-11 min-w-11 flex items-center justify-center" style="color: var(--color-body);" aria-label="Close menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <nav aria-label="Mobile navigation">
          <ul class="flex flex-col gap-1">
            <li><a href="/" class="mobile-nav-link">Home</a></li>
            <li><a href="/directory" class="mobile-nav-link mobile-highlight">Find Help Near You</a></li>
            <li><a href="/blog" class="mobile-nav-link">Stories</a></li>
            <li><a href="/donate" class="mobile-nav-link mobile-highlight">Donate</a></li>
          </ul>

          <p class="mobile-group-label">Get Involved</p>
          <ul class="flex flex-col gap-1">
            <li><a href="/volunteer" class="mobile-nav-link">Volunteer</a></li>
            <li><a href="/join" class="mobile-nav-link">Join Us</a></li>
            <li><a href="/how-to-help" class="mobile-nav-link">How to Help</a></li>
          </ul>

          <p class="mobile-group-label">About</p>
          <ul class="flex flex-col gap-1">
            <li><a href="/about" class="mobile-nav-link">About Us</a></li>
            <li><a href="/purpose" class="mobile-nav-link">Our Purpose</a></li>
            <li><a href="/impact" class="mobile-nav-link">Impact</a></li>
            <li><a href="/partners" class="mobile-nav-link">Partners</a></li>
          </ul>

          <p class="mobile-group-label">Resources</p>
          <ul class="flex flex-col gap-1">
            <li><a href="/events" class="mobile-nav-link">Events</a></li>
            <li><a href="/photos" class="mobile-nav-link">Photos</a></li>
            <li><a href="/programs" class="mobile-nav-link">Programs</a></li>
            <li><a href="/technology-access" class="mobile-nav-link">Technology Access</a></li>
            <li><a href="/guide" class="mobile-nav-link">Resource Guide</a></li>
            <li><a href="/es" class="mobile-nav-link">Espanol</a></li>
          </ul>

          <p class="mobile-group-label">Connect</p>
          <ul class="flex flex-col gap-1">
            <li><a href="/contact" class="mobile-nav-link">Contact</a></li>
            <li><a href="/feedback" class="mobile-nav-link">Feedback</a></li>
            <li><a href="/share-your-story" class="mobile-nav-link">Share Your Story</a></li>
            <li><a href="/socials" class="mobile-nav-link">Socials</a></li>
          </ul>

          <p class="mobile-group-label">Legal</p>
          <ul class="flex flex-col gap-1">
            <li><a href="/privacy" class="mobile-nav-link">Privacy</a></li>
            <li><a href="/terms" class="mobile-nav-link">Terms</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </header>

  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-5 sm:py-8 xl:pb-12">
    <slot />
  </main>

  <footer class="px-4 pt-16 pb-12">
      <div class="mx-auto max-w-6xl">
        <p class="font-display text-4xl font-semibold leading-none tracking-tight mb-8" style="color: var(--color-body);">Base Impact</p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" style="color: var(--color-muted);">
          <div>
            <p>Scottsmoor, FL 32775</p>
            <p class="mt-2">
              <a href="tel:+13213230999" class="font-medium hover:underline" style="color: var(--color-body);">(321) 323-0999</a>
              · call or text · by appointment only
            </p>
          </div>
          <div class="sm:text-right">
            <p>© {new Date().getFullYear()} Base Impact Inc.</p>
            <p class="mt-1 text-sm">Tip: Use your browser's translate feature for other languages.</p>
            <div class="mt-2 flex gap-4 sm:justify-end">
              <a href="/privacy" class="hover:underline" style="color: var(--color-body);">Privacy</a>
              <a href="/terms" class="hover:underline" style="color: var(--color-body);">Terms</a>
            </div>
            <!-- Crisis links in footer - WCAG 2.5.8 AA compliant tap targets -->
            <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
              <a href="tel:911" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 py-1 font-semibold text-on-fill underline-offset-2 hover:underline" style="color: var(--color-body);" aria-label="Call 911 for immediate danger">
                911
              </a>
              <span class="text-faint" aria-hidden="true">·</span>
              <a href="tel:211" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 py-1 font-semibold text-on-fill underline-offset-2 hover:underline" style="color: var(--color-body);" aria-label="Call 211 for 24/7 local help">
                211
              </a>
              <span class="text-faint" aria-hidden="true">·</span>
              <a href="tel:988" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 py-1 font-semibold text-on-fill underline-offset-2 hover:underline" style="color: var(--color-body);" aria-label="Call 988 for crisis support">
                988
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  <!-- Floating "Get Help: Call 211" button (opens in a new tab so the visitor keeps the directory) -->
  <a href="tel:211" id="floating-help-btn" target="_blank" rel="noopener noreferrer" aria-label="Get help: Call 211" style="
    position: fixed; bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px)); right: 1rem; z-index: 9997;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.7rem 1.1rem; background: var(--color-accent); color: #fff;
    border-radius: 999px; font-weight: 700; font-size: 0.85rem; text-decoration: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.3s, transform 0.3s;
  ">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
    </svg>
    <span class="help-full">Get Help: Call 211</span>
    <span class="help-short">211</span>
  </a>
</div>

<style>
  .help-short { display: none; }
  @media (max-width: 640px) {
    /* Compact CTA on phones so it cannot cover card actions. */
    #floating-help-btn { padding: 0.7rem 0.85rem; }
    #floating-help-btn .help-full { display: none; }
    #floating-help-btn .help-short { display: inline; }
  }

  .mega-group { position: relative; }
  .mega-trigger {
    display: flex; align-items: center; gap: 0.25rem;
    padding: 0.625rem 0.9rem; font-size: 1rem; font-weight: 500;
    white-space: nowrap;
    color: var(--color-body); background: none; border: none; cursor: pointer;
    border-radius: 999px; transition: background 0.15s;
    min-height: 2.75rem; /* 44px - WCAG 2.5.8 AA */
  }
  .mega-trigger:hover { background: var(--color-inset); }
  .mega-chevron { transition: transform 0.2s; }
  .mega-group.open .mega-chevron { transform: rotate(180deg); }

  .mega-panel {
    position: absolute; top: 100%; left: 0; min-width: 200px;
    padding: 0.5rem; background: var(--color-card);
    border: 1px solid var(--color-line); border-radius: 0.75rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    z-index: 50;
  }
  .mega-group.open .mega-panel {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .mega-panel a {
    display: block; padding: 0.5rem 0.75rem; font-size: 0.875rem;
    color: var(--color-body); text-decoration: none; border-radius: 0.5rem;
    transition: background 0.1s;
    min-height: 2.75rem; /* 44px - WCAG 2.5.8 AA */
    display: flex; align-items: center;
  }
  .mega-panel a:hover { background: var(--color-inset); }
  .mega-highlight { color: var(--color-accent) !important; font-weight: 600; }

  .mega-link {
    padding: 0.625rem 0.9rem; font-size: 1rem; font-weight: 500;
    white-space: nowrap;
    color: var(--color-body); text-decoration: none; border-radius: 999px;
    transition: background 0.15s;
  }
  .mega-link:hover { background: var(--color-inset); }

  .mobile-nav-link {
    display: flex; align-items: center; min-height: 2.75rem;
    padding: 0.5rem 0.75rem; font-size: 1rem; font-weight: 500;
    color: var(--color-body); text-decoration: none; border-radius: 0.5rem;
    transition: background 0.1s;
  }
  .mobile-nav-link:hover { background: var(--color-inset); }
  .mobile-highlight { color: var(--color-accent); font-weight: 600; }
  .mobile-group-label {
    margin-top: 1.25rem; margin-bottom: 0.25rem; padding: 0 0.75rem;
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--color-muted);
  }
</style>

<script>
  document.querySelectorAll('.mega-group').forEach(group => {
    const trigger = group.querySelector('.mega-trigger');
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.classList.contains('open');
      document.querySelectorAll('.mega-group.open').forEach(g => {
        if (g !== group) g.classList.remove('open');
        g.querySelector('.mega-trigger')?.setAttribute('aria-expanded', 'false');
      });
      group.classList.toggle('open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.mega-group')) {
      document.querySelectorAll('.mega-group.open').forEach(g => {
        g.classList.remove('open');
        g.querySelector('.mega-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.mega-group.open').forEach(g => {
        g.classList.remove('open');
        g.querySelector('.mega-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
  const mobileClose = document.getElementById('mobile-close');

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    mobileBackdrop?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    mobileBackdrop?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMobileMenu);
  mobileClose?.addEventListener('click', closeMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);

  document.querySelectorAll('#mobile-menu a').forEach(a => {
    a.addEventListener('click', closeMobileMenu);
  });

  const triageBtn = document.getElementById('triage-btn');
  if (triageBtn) {
    triageBtn.addEventListener('click', () => {
      const overlay = document.createElement('div');
      overlay.id = 'triage-overlay';
      overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;padding:1rem;';
      overlay.innerHTML = `
        <div style="background:var(--color-card);border-radius:1rem;padding:1.5rem;max-width:400px;width:100%;max-height:90vh;overflow-y:auto;">
          <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:600;margin-bottom:1rem;color:var(--color-body);">Need Help Now?</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            <a href="tel:911" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-critical);color:var(--color-critical);font-weight:600;text-decoration:none;">Call 911 — Emergency</a>
            <a href="tel:211" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-caution);color:var(--color-caution);font-weight:600;text-decoration:none;">Call 211 — Find local help</a>
            <a href="tel:988" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-caution);color:var(--color-caution);font-weight:600;text-decoration:none;">Call 988 — Crisis lifeline</a>
            <a href="/directory" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-inset);color:var(--color-body);font-weight:600;text-decoration:none;">Browse all resources</a>
          </div>
          <button type="button" onclick="document.getElementById('triage-overlay').remove()" style="margin-top:1rem;width:100%;padding:0.75rem;border-radius:0.75rem;border:1px solid var(--color-line);background:var(--color-card);color:var(--color-body);font-weight:600;cursor:pointer;">Close</button>
        </div>
      `;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.remove();
      });
    });
  }
  // Floating help button — show after scrolling past hero
  const floatBtn = document.getElementById('floating-help-btn');
  if (floatBtn) {
    const showBtn = () => {
      if (window.scrollY > 300) {
        floatBtn.style.opacity = '1';
        floatBtn.style.transform = 'translateY(0)';
      } else {
        floatBtn.style.opacity = '0';
        floatBtn.style.transform = 'translateY(20px)';
      }
    };
    window.addEventListener('scroll', showBtn, { passive: true });
    showBtn();
  }
</script>
