---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Navigation from './Navigation.astro';
---

<div class="site-shell">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-card focus:px-3 focus:py-2">
    Skip to content
  </a>

  <aside class="px-4 py-2 text-center text-sm font-medium" style="color: var(--color-muted);">
    Base Impact Inc. · EIN 43-2200667 · Florida nonprofit corporation · FDACS registered · Brevard County, FL
  </aside>

  <Navigation />

  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-5 sm:py-8 xl:pb-12">
    <slot />
  </main>

  <footer class="px-4 pt-16 pb-12">
      <div class="mx-auto max-w-6xl">
        <p class="font-display text-4xl font-semibold leading-none tracking-tight mb-8" style="color: var(--color-body);">Base Impact</p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" style="color: var(--color-muted);">
          <div>
            <p>Scottsmoor, FL 32775</p>
            <p class="mt-2">
              <a href="tel:+13213230999" class="font-medium hover:underline" style="color: var(--color-body);">(321) 323-0999</a>
              · call or text · by appointment only
            </p>
          </div>
          <div class="sm:text-right">
            <p>© {new Date().getFullYear()} Base Impact Inc.</p>
            <p class="mt-1 text-sm">Tip: Use your browser's translate feature for other languages.</p>
            <div class="mt-2 flex gap-4 sm:justify-end">
              <a href="/privacy" class="hover:underline" style="color: var(--color-body);">Privacy</a>
              <a href="/terms" class="hover:underline" style="color: var(--color-body);">Terms</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  <!-- Floating "Get Help: Call 211" button -->
  <a href="tel:211" id="floating-help-btn" aria-label="Get help: Call 211" style="
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9997;
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.25rem; background: var(--color-accent, #f4d96c); color: var(--color-page, #0f1a14);
    border-radius: 999px; font-weight: 700; font-size: 0.9rem; text-decoration: none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.3s, transform 0.3s;
  ">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
    </svg>
    Get Help: Call 211
  </a>
</div>

<style>
  .mega-group { position: relative; }
  .mega-trigger {
    display: flex; align-items: center; gap: 0.25rem;
    padding: 0.5rem 0.75rem; font-size: 0.875rem; font-weight: 500;
    color: var(--color-body); background: none; border: none; cursor: pointer;
    border-radius: 0.5rem; transition: background 0.15s;
  }
  .mega-trigger:hover { background: var(--color-inset); }
  .mega-chevron { transition: transform 0.2s; }
  .mega-group.open .mega-chevron { transform: rotate(180deg); }

  .mega-panel {
    position: absolute; top: 100%; left: 0; min-width: 200px;
    padding: 0.5rem; background: var(--color-card);
    border: 1px solid var(--color-line); border-radius: 0.75rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    z-index: 50;
  }
  .mega-group.open .mega-panel {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .mega-panel a {
    display: block; padding: 0.5rem 0.75rem; font-size: 0.875rem;
    color: var(--color-body); text-decoration: none; border-radius: 0.5rem;
    transition: background 0.1s;
  }
  .mega-panel a:hover { background: var(--color-inset); }
  .mega-highlight { color: var(--color-accent) !important; font-weight: 600; }

  .mega-link {
    padding: 0.5rem 0.75rem; font-size: 0.875rem; font-weight: 500;
    color: var(--color-body); text-decoration: none; border-radius: 0.5rem;
    transition: background 0.15s;
  }
  .mega-link:hover { background: var(--color-inset); }

  .mobile-nav-link {
    display: flex; align-items: center; min-height: 2.75rem;
    padding: 0.5rem 0.75rem; font-size: 1rem; font-weight: 500;
    color: var(--color-body); text-decoration: none; border-radius: 0.5rem;
    transition: background 0.1s;
  }
  .mobile-nav-link:hover { background: var(--color-inset); }
  .mobile-highlight { color: var(--color-accent); font-weight: 600; }
  .mobile-group-label {
    margin-top: 1.25rem; margin-bottom: 0.25rem; padding: 0 0.75rem;
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--color-muted);
  }
</style>

<script>
  document.querySelectorAll('.mega-group').forEach(group => {
    const trigger = group.querySelector('.mega-trigger');
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.classList.contains('open');
      document.querySelectorAll('.mega-group.open').forEach(g => {
        if (g !== group) g.classList.remove('open');
        g.querySelector('.mega-trigger')?.setAttribute('aria-expanded', 'false');
      });
      group.classList.toggle('open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.mega-group')) {
      document.querySelectorAll('.mega-group.open').forEach(g => {
        g.classList.remove('open');
        g.querySelector('.mega-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.mega-group.open').forEach(g => {
        g.classList.remove('open');
        g.querySelector('.mega-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
  const mobileClose = document.getElementById('mobile-close');

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    mobileBackdrop?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    mobileBackdrop?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMobileMenu);
  mobileClose?.addEventListener('click', closeMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);

  document.querySelectorAll('#mobile-menu a').forEach(a => {
    a.addEventListener('click', closeMobileMenu);
  });

  const triageBtn = document.getElementById('triage-btn');
  if (triageBtn) {
    triageBtn.addEventListener('click', () => {
      const overlay = document.createElement('div');
      overlay.id = 'triage-overlay';
      overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;padding:1rem;';
      overlay.innerHTML = `
        <div style="background:var(--color-card);border-radius:1rem;padding:1.5rem;max-width:400px;width:100%;max-height:90vh;overflow-y:auto;">
          <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:600;margin-bottom:1rem;color:var(--color-body);">Need Help Now?</h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            <a href="tel:911" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-critical);color:var(--color-critical);font-weight:600;text-decoration:none;">Call 911 — Emergency</a>
            <a href="tel:211" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-caution);color:var(--color-caution);font-weight:600;text-decoration:none;">Call 211 — Find local help</a>
            <a href="tel:988" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-tint-caution);color:var(--color-caution);font-weight:600;text-decoration:none;">Call 988 — Crisis lifeline</a>
            <a href="/directory" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.75rem;background:var(--color-inset);color:var(--color-body);font-weight:600;text-decoration:none;">Browse all resources</a>
          </div>
          <button type="button" onclick="document.getElementById('triage-overlay').remove()" style="margin-top:1rem;width:100%;padding:0.75rem;border-radius:0.75rem;border:1px solid var(--color-line);background:var(--color-card);color:var(--color-body);font-weight:600;cursor:pointer;">Close</button>
        </div>
      `;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.remove();
      });
    });
  }
  // Floating help button — show after scrolling past hero
  const floatBtn = document.getElementById('floating-help-btn');
  if (floatBtn) {
    const showBtn = () => {
      if (window.scrollY > 300) {
        floatBtn.style.opacity = '1';
        floatBtn.style.transform = 'translateY(0)';
      } else {
        floatBtn.style.opacity = '0';
        floatBtn.style.transform = 'translateY(20px)';
      }
    };
    window.addEventListener('scroll', showBtn, { passive: true });
    showBtn();
  }
</script>
