---
import StatusBadge from './StatusBadge.astro';
import { telHref, directionsHref, transitHref, walkHref, servicePageLabel } from '../lib/resources/links';

interface Props {
  resource: any;
}

const { resource } = Astro.props;

const phone = resource.phone?.trim() ?? '';
const hasPhone = phone.length > 0;
const canNavigate = !resource.mobileOnly && resource.address.trim().length > 0;
const webUrl = resource.serviceUrl || resource.website;
const hasWeb = typeof webUrl === 'string' && webUrl.trim().length > 0;
const webLabel = hasWeb ? servicePageLabel(webUrl, resource.website) : '';
---

<article class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] sm:p-7 flex flex-col h-full" data-resource-id={resource.id}>
  <h3 class="font-display text-xl font-semibold leading-snug text-body">{resource.name}</h3>
  <div class="mt-1 flex items-center justify-between gap-2">
    <p class="text-sm font-semibold uppercase tracking-wide text-muted">
      {resource.category}
      <span class="mx-1.5 text-faint">·</span>
      {resource.partnerType}
    </p>
    <button
      type="button"
      class="save-btn relative shrink-0 size-9 rounded-xl text-muted after:absolute after:left-1/2 after:top-1/2 after:size-9 after:-translate-x-1/2 after:-translate-y-1/2"
      data-resource-id={resource.id}
      aria-pressed="false"
      aria-label="Save for later"
    >
      <svg class="mx-auto size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    </button>
  </div>
  <div class="mt-2">
    <StatusBadge avail={resource.nextAvail} className="max-w-full" />
  </div>
  {resource.lastVerified && (
    <p class="mt-1.5 text-xs font-semibold text-faint">
      Verified {new Date(resource.lastVerified).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
    </p>
  )}

  <p class="mt-3 text-muted">{resource.description}</p>
  <p class="mt-2 text-sm font-semibold text-body">{resource.hoursText}</p>

  <ul class="mt-3 flex flex-wrap gap-1.5">
    {resource.tags.map((tag: string) => (
      <li class="rounded-md bg-inset px-2 py-1 text-xs font-semibold text-muted">{tag}</li>
    ))}
  </ul>

  {(resource.eligibility || resource.documents || (resource.languages && resource.languages.length > 0) || resource.accessibility) && (
    <dl class="mt-4 space-y-2 rounded-xl bg-inset p-3">
      {resource.eligibility && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-faint">Who qualifies</dt>
          <dd class="mt-0.5 text-sm text-muted">{resource.eligibility}</dd>
        </div>
      )}
      {resource.documents && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-faint">What to bring</dt>
          <dd class="mt-0.5 text-sm text-muted">{resource.documents}</dd>
        </div>
      )}
      {resource.languages && resource.languages.length > 0 && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-faint">Languages</dt>
          <dd class="mt-0.5 text-sm text-muted">{resource.languages.join(', ')}</dd>
        </div>
      )}
      {resource.accessibility && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-faint">Accessibility</dt>
          <dd class="mt-0.5 text-sm text-muted">{resource.accessibility}</dd>
        </div>
      )}
    </dl>
  )}

  <div class="mt-4 flex items-start gap-2 text-sm text-muted">
    <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    <span>
      {resource.address}
      {canNavigate && (
        <span class="mt-0.5 block font-semibold text-body tabular-nums distance-miles">
          {resource.distanceMiles} miles away (straight line)
        </span>
      )}
    </span>
  </div>

  <div class="mt-auto pt-4 flex flex-wrap gap-2">
    {hasPhone && (
      <a href={telHref(phone)} class="min-w-[120px] flex-1 rounded-xl border border-line bg-card px-4 py-2 text-center text-sm font-semibold text-body hover:bg-inset">
        <svg class="inline size-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call
      </a>
    )}
    {hasWeb && (
      <a href={webUrl} target="_blank" rel="noreferrer" title={webUrl}
        class="min-w-[120px] flex-1 rounded-xl border border-line bg-card px-4 py-2 text-center text-sm font-semibold text-body hover:bg-inset">
        <svg class="inline size-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        {webLabel}
      </a>
    )}
    {canNavigate && (
      <a href={directionsHref(resource.address)} target="_blank" rel="noreferrer" aria-label={`Open directions to ${resource.name} in your map app`}
        class="min-w-[120px] flex-1 rounded-xl border border-line bg-card px-4 py-2 text-center text-sm font-semibold text-body hover:bg-inset">
        Map
      </a>
    )}
    {canNavigate && (
      <a href={transitHref(resource.address)} target="_blank" rel="noreferrer" aria-label={`Open 321transit trip planner to plan a bus route to ${resource.name}`}
        class="min-w-[100px] flex-1 rounded-xl border border-line bg-card px-4 py-2 text-center text-sm font-semibold text-body hover:bg-inset">
        Bus
      </a>
    )}
    {canNavigate && (
      <button type="button" data-copy-address={resource.address}
        class="copy-addr-btn min-w-[100px] flex-1 rounded-xl border border-line bg-card px-4 py-2 text-center text-sm font-semibold text-body hover:bg-inset">
        Copy address
      </button>
    )}
    {canNavigate && (
      <a href={walkHref(resource.address)} target="_blank" rel="noreferrer" aria-label={`Open walking directions to ${resource.name}`}
        class="min-w-[100px] flex-1 rounded-xl border border-line bg-card px-4 py-2 text-center text-sm font-semibold text-body hover:bg-inset">
        Walk
      </a>
    )}
  </div>
  <!-- Crowdsourced verification -->
  <div class="mt-3 text-xs text-faint">
    Help us keep this accurate — <button type="button" class="text-accent underline report-issue-btn" data-resource-id={resource.id} data-resource-name={resource.name}>report an issue</button>
  </div>

</article>
