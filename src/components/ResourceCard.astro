---
/**
 * ResourceCard — the single card every listing is rendered with.
 *
 * Visual hierarchy (scan first, act second):
 *   1. Left: Distance badge (the #1 question: how far?)
 *   2. Right: Open-now badge with pulse animation (the #1 urgency)
 *   3. Header: name, category, tags, save button
 *   4. Distance row (prominent, inset background)
 *   5. Body: address + hours side-by-side, collapsible description
 *   6. Actions: Call (primary) + Map + Web (secondary)
 *   7. Footer: status badge, verified date, report issue
 *
 * Lightbox: resource photos are clickable — click a card image to zoom to full size.
 * The hero image of a blog post uses the same pattern.
 */
import StatusBadge from './StatusBadge.astro';
import { telHref, directionsHref, domainOf } from '@/lib/resources/links';

interface Props {
  resource: any;
}

const { resource } = Astro.props;

const phone = resource.phone?.trim() ?? '';
const hasPhone = phone.length > 0;
const canNavigate = !resource.mobileOnly && resource.address.trim().length > 0;
const webUrl = resource.serviceUrl || resource.website;
const hasWeb = typeof webUrl === 'string' && webUrl.trim().length > 0;
const webLabel = hasWeb ? (webUrl.includes('facebook.com') ? 'Facebook' : webUrl.includes('instagram.com') ? 'Instagram' : 'Website') : '';
const hasDistance = resource.distanceMiles > 0 && resource.distanceMiles < 9999;
const distText = hasDistance ? `${resource.distanceMiles.toFixed(1)} mi` : 'No map';

const isOpen = resource.nextAvail?.status === 'OPEN';
const statusLabel = resource.nextAvail?.label || '';

const descPreview = (resource.description || '').split('.').find(Boolean) || '';
const verifiedDate = resource.lastVerified
  ? new Date(resource.lastVerified).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Unverified';

// Determine the best image for lightbox (first in priority order).
const photoCandidate = resource.photo || resource.image || '';
---

<article
  class="resource-card bg-card border border-line rounded-2xl overflow-hidden transition-shadow hover:shadow-border-hover"
  data-resource-id={resource.id}
  data-lat={resource.lat}
  data-lng={resource.lng}
  role="article"
  aria-labelledby={`card-${resource.id}-name`}
>
  {/* Cover photo — clickable to zoom (lightbox) */}
  {photoCandidate && (
    <button
      type="button"
      class="resource-card-cover"
      data-lightbox-src={photoCandidate}
      aria-label={`View ${resource.name} photo in full size`}
    >
      <img
        src={photoCandidate}
        alt={resource.name}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        width={640}
        height={360}
      />
      <span class="sr-only">{resource.name}</span>
    </button>
  )}

  {/* Open now badge — top right */}
  {isOpen && (
    <div class="open-badge" aria-live="polite">
      <span>Open now</span>
    </div>
  )}

  <!-- Header: category, name, tags, save -->
  <header class="resource-card-header">
    <div class="resource-card-header-content">
      <p class="resource-card-category">
        {resource.category} · {resource.partnerType}
      </p>
      <h3
        id={`card-${resource.id}-name`}
        class="resource-card-name"
        title={resource.name}
      >
        {resource.name}
      </h3>
      <div class="resource-card-tags" aria-label="Services offered">
        {(resource.tags || []).slice(0, 4).map((tag: string) => (
          <span class="resource-tag">{tag}</span>
        ))}
        {(resource.tags || []).length > 4 && (
          <span class="resource-tag-more">+{resource.tags.length - 4} more</span>
        )}
      </div>
    </div>
    <button
      type="button"
      class="resource-card-save save-btn"
      data-resource-id={resource.id}
      aria-pressed="false"
      aria-label={`Save ${resource.name} for later`}
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
    </button>
  </header>

  <!-- Distance row (prominent) -->
  {hasDistance && (
    <div class="resource-card-distance" aria-label={`Distance: ${distText}`}>
      <span class="resource-card-distance-label">How far</span>
      <span class="resource-card-distance-value">
        {distText}
        <span class="text-faint font-normal text-xs ml-1">away</span>
      </span>
    </div>
  )}

  <!-- Body: address + hours -->
  <div class="resource-card-body">
    <div class="resource-card-info-row">
      <div class="resource-card-address">
        <span class="resource-card-info-label">Address</span>
        <address class="resource-card-address-value">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{resource.address}</span>
          <button
            type="button"
            class="resource-card-copy-btn copy-addr-btn"
            data-copy-address={resource.address}
            aria-label="Copy address to clipboard"
          >
            Copy
          </button>
        </address>
      </div>
      <div class="resource-card-hours">
        <span class="resource-card-info-label">Hours</span>
        <span class="resource-card-hours-value">
          {resource.hoursText || 'Call for hours'}
        </span>
      </div>
    </div>

    <!-- Description (collapsible) -->
    {resource.description && (
      <details class="resource-card-description">
        <summary>Details</summary>
        <p>{descPreview}</p>
      </details>
    )}
  </div>

  <!-- Primary actions -->
  <div class="resource-card-actions" role="group" aria-label="Primary actions">
    {hasPhone && (
      <a href={telHref(phone)} class="action-btn action-btn-primary" aria-label={`Call ${resource.name}`}>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call
      </a>
    )}
    {canNavigate && (
      <a
        href={directionsHref(resource.address)}
        target="_blank" rel="noreferrer"
        class="action-btn action-btn-secondary"
        aria-label={`Open directions to ${resource.name} in your map app`}
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="3 11 22 2 13 21 11 11 3 3 3 11"/>
          <path d="M13.5 8.5L19 2l1.5 8L23 16l-6-4-6 4 1.5 8z"/>
        </svg>
        Map
      </a>
    )}
    {hasWeb && (
      <a href={webUrl} target="_blank" rel="noreferrer" class="action-btn action-btn-secondary" aria-label={`${webLabel} for ${resource.name}`}>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        {webLabel}
      </a>
    )}
  </div>

  <!-- Mobile: per-card "Open in Maps" link -->
  {canNavigate && (
    <a
      href={directionsHref(resource.address)}
      target="_blank" rel="noreferrer"
      class="card-map-link"
      aria-label={`Open directions to ${resource.name} in your map app`}
    >
      Open in Maps →
    </a>
  )}

  <!-- Footer: status + report + verified -->
  <footer class="resource-card-footer">
    <div class="resource-card-footer-left">
      {resource.nextAvail && (
        <StatusBadge avail={resource.nextAvail} class="status-badge" />
      )}
      <span class="resource-card-verified">
        Verified {verifiedDate}
      </span>
    </div>
    <button
      type="button"
      class="resource-card-report report-issue-btn"
      data-resource-id={resource.id}
      data-resource-name={resource.name}
      aria-label={`Report an issue with ${resource.name}`}
    >
      Report an issue
    </button>
  </footer>
</article>

<style>
  .resource-card-cover {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    cursor: zoom-in;
    background: var(--color-inset);
    aspect-ratio: 16 / 9;
  }
  .resource-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .resource-card-cover:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }

  .open-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-positive);
    color: var(--color-on-positive);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    box-shadow: var(--shadow-border);
  }
  .open-badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    animation: pulse-soft 1.5s ease-in-out infinite;
  }
  @keyframes pulse-soft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .open-badge::before { animation: none; opacity: 1; }
  }

  .resource-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
  }
  .resource-card-header-content { flex: 1; min-width: 0; }
  .resource-card-category {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
    margin-bottom: 0.25rem;
  }
  .resource-card-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-body);
    overflow-wrap: anywhere;
  }
  .resource-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }
  .resource-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-muted);
    background: var(--color-inset);
    border-radius: 9999px;
  }
  .resource-tag-more {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-faint);
  }

  .resource-card-save {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-lg);
    color: var(--color-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .resource-card-save:hover,
  .resource-card-save[aria-pressed="true"] {
    color: var(--color-accent);
    background: var(--color-signal-soft);
  }
  .resource-card-save[aria-pressed="true"] svg { fill: currentColor; }

  .resource-card-distance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.25rem;
    background: var(--color-inset);
  }
  .resource-card-distance-label {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
  }
  .resource-card-distance-value {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-link);
  }

  .resource-card-body {
    padding: 1rem 1.25rem;
    flex: 1;
  }
  .resource-card-info-row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .resource-card-info-row { grid-template-columns: 1fr 1fr; }
  }
  .resource-card-address,
  .resource-card-hours {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .resource-card-info-label {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
  }
  .resource-card-address-value {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .resource-card-address-value svg { flex-shrink: 0; margin-top: 0.125rem; color: var(--color-faint); }
  .resource-card-copy-btn {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .resource-card-copy-btn:hover { color: #c3c3fb; }
  .resource-card-hours-value { font-size: 0.8125rem; color: var(--color-muted); }

  .resource-card-description {
    margin-top: 1rem;
  }
  .resource-card-description summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-faint);
    list-style: none;
  }
  .resource-card-description summary::-webkit-details-marker { display: none; }
  .resource-card-description summary::after {
    content: '▾';
    font-size: 0.5em;
    transition: transform 0.2s var(--ease-out-expo);
  }
  .resource-card-description[open] summary::after { transform: rotate(180deg); }
  .resource-card-description p {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .resource-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .resource-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--color-line);
    flex-wrap: wrap;
  }
  .resource-card-footer-left { display: flex; align-items: center; gap: 0.75rem; }
  .resource-card-verified {
    font-size: 0.625rem;
    color: var(--color-faint);
  }
  .resource-card-report {
    font-size: 0.6875rem;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .resource-card-report:hover { color: var(--color-link); }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
  }
  .status-badge-open { background: var(--color-tint-positive); color: var(--color-on-positive); }
  .status-badge-soon { background: var(--color-tint-caution); color: var(--color-on-caution); }
  .status-badge-closed { background: var(--color-tint-critical); color: var(--color-on-critical); }
  .status-badge-unknown { background: var(--color-tint-inactive); color: var(--color-on-inactive); }
  .status-badge::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: currentColor;
  }
  .status-badge-open::before { animation: pulse-soft 1.5s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .status-badge-open::before { animation: none; }
  }

  .card-map-link {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-link);
    border-top: 1px solid var(--color-line);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .card-map-link:hover { color: #c3c3fb; background: var(--color-inset); border-radius: var(--radius-lg); }
  @media (min-width: 1024px) { .card-map-link { display: none; } }
</style>
