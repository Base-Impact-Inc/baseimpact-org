---
import { telHref, directionsHref, transitHref, walkHref } from '../lib/resources/links';

interface Props {
  resource: any;
}

const { resource } = Astro.props;

const phone = resource.phone?.trim() ?? '';
const hasPhone = phone.length > 0;
const canNavigate = !resource.mobileOnly && resource.address.trim().length > 0;
---

<a href={resource.website || resource.serviceUrl || '#'} target="_blank" rel="noopener noreferrer" class="block rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700 hover:shadow-lg transition-shadow h-full">
  <div class="flex items-start justify-between gap-2 mb-2">
    <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white leading-snug">{resource.name}</h3>
    <button
      type="button"
      class="save-btn relative shrink-0 size-8 rounded-lg text-gray-400 hover:text-accent"
      data-resource-id={resource.id}
      aria-pressed="false"
      aria-label="Save for later"
      onclick="event.preventDefault(); event.stopPropagation();"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    </button>
  </div>

  <p class="text-sm text-gray-600 dark:text-slate-300 mb-3 line-clamp-2">{resource.description}</p>

  <div class="flex flex-wrap gap-1.5 mb-3">
    <span class="rounded-md bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 text-xs font-semibold text-blue-700 dark:text-blue-300">{resource.category}</span>
    {(resource.services || []).slice(0, 3).map((service: string) => (
      <span class="rounded-md bg-gray-100 dark:bg-slate-700 px-2 py-0.5 text-xs font-medium text-gray-700 dark:text-slate-300">{service}</span>
    ))}
  </div>

  <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-slate-400">
    {hasPhone && (
      <a href={telHref(phone)} class="hover:text-accent flex items-center gap-1" onclick="event.preventDefault(); event.stopPropagation();">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call
      </a>
    )}
    {canNavigate && (
      <a href={directionsHref(resource.address)} target="_blank" rel="noreferrer" class="hover:text-accent flex items-center gap-1" onclick="event.preventDefault(); event.stopPropagation();">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Map
      </a>
    )}
    <span class="truncate">{resource.address}</span>
  </div>
</a>
