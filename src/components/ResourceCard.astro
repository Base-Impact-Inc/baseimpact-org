---
/**
 * Redesigned ResourceCard — Phase 2
 *
 * Improvements:
 * 1. Distance badge top-left (prominent, sticky visual anchor)
 * 2. Open-now badge top-right with pulse animation
 * 3. Name + category + tags in header, save button top-right
 * 4. Distance row prominent (inset background)
 * 5. Address + hours side-by-side on ≥640px
 * 6. Collapsible description (<details>)
 * 7. Primary action bar: Call (primary) + Map + Web (secondary)
 * 8. Footer: status badge + report issue + verified date
 * 9. Mobile: per-card "Open in Maps" link
 * 10. Accessibility: proper ARIA, focus order, semantic HTML
 */

import StatusBadge from './StatusBadge.astro';
import { telHref, directionsHref } from '../lib/resources/links';

interface Props {
  resource: any;
}

const { resource } = Astro.props;

const phone = resource.phone?.trim() ?? '';
const hasPhone = phone.length > 0;
const canNavigate = !resource.mobileOnly && resource.address.trim().length > 0;
const webUrl = resource.serviceUrl || resource.website;
const hasWeb = typeof webUrl === 'string' && webUrl.trim().length > 0;
const webLabel = hasWeb ? (webUrl.includes('facebook.com') ? 'Facebook' : webUrl.includes('instagram.com') ? 'Instagram' : 'Website') : '';
const hasDistance = resource.distanceMiles > 0 && resource.distanceMiles < 9999;
const distText = hasDistance ? `${resource.distanceMiles.toFixed(1)} mi` : 'No map';

// Status
const isOpen = resource.nextAvail?.status === 'OPEN';
const statusLabel = resource.nextAvail?.label || '';

// First sentence of description for preview
const descPreview = (resource.description || '').split('.').find(Boolean) || '';

// Format verified date
const verifiedDate = resource.lastVerified
  ? new Date(resource.lastVerified).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Unverified';
---

<article
  class="resource-card bg-card border border-line rounded-2xl overflow-hidden transition-shadow hover:shadow-border-hover"
  data-resource-id={resource.id}
  data-lat={resource.lat}
  data-lng={resource.lng}
  role="article"
  aria-labelledby={`card-${resource.id}-name`}
>

  <!-- Distance badge — TOP LEFT, always visible -->
  {hasDistance && (
    <span class="distance-badge" aria-label={`${resource.distanceMiles.toFixed(1)} miles away`}>
      {distText}
    </span>
  )}

  <!-- Open now badge — TOP RIGHT -->
  {isOpen && (
    <div class="open-badge" aria-live="polite">
      <span>Open now</span>
    </div>
  )}

  <!-- Header: category, name, tags, save -->
  <header class="resource-card-header">
    <div class="resource-card-header-content">
      <p class="resource-card-category">
        {resource.category} · {resource.partnerType}
      </p>
      <h3 id={`card-${resource.id}-name`} class="resource-card-name">
        {resource.name}
      </h3>
      <div class="resource-card-tags" aria-label="Services offered">
        {resource.tags.slice(0, 4).map((tag: string) => (
          <span class="resource-tag">{tag}</span>
        ))}
        {resource.tags.length > 4 && (
          <span class="resource-tag-more">+{resource.tags.length - 4} more</span>
        )}
      </div>
    </div>
    <button
      type="button"
      class="resource-card-save save-btn"
      data-resource-id={resource.id}
      aria-pressed="false"
      aria-label={`Save ${resource.name} for later`}
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
    </button>
  </header>

  <!-- Distance row (prominent) -->
  {hasDistance && (
    <div class="resource-card-distance" aria-label={`Distance: ${distText}`}>
      <span class="resource-card-distance-label">How far</span>
      <span class="resource-card-distance-value">
        {distText}
        <span class="text-faint font-normal text-xs ml-1">away</span>
      </span>
    </div>
  )}

  <!-- Body: address + hours -->
  <div class="resource-card-body">
    <div class="resource-card-info-row">
      <div class="resource-card-address">
        <span class="resource-card-info-label">Address</span>
        <address class="resource-card-address-value">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{resource.address}</span>
          <button
            type="button"
            class="resource-card-copy-btn copy-addr-btn"
            data-copy-address={resource.address}
            aria-label="Copy address to clipboard"
          >
            Copy
          </button>
        </address>
      </div>
      <div class="resource-card-hours">
        <span class="resource-card-info-label">Hours</span>
        <span class="resource-card-hours-value">
          {resource.hoursText || 'Call for hours'}
        </span>
      </div>
    </div>

    <!-- Description (collapsible) -->
    {resource.description && (
      <details class="resource-card-description">
        <summary>Details</summary>
        <p>{resource.description}</p>
      </details>
    )}
  </div>

  <!-- Primary actions -->
  <div class="resource-card-actions" role="group" aria-label="Primary actions">
    {hasPhone && (
      <a
        href={telHref(phone)}
        class="action-btn action-btn-primary"
        aria-label={`Call ${resource.name}`}
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call
      </a>
    )}
    {canNavigate && (
      <a
        href={directionsHref(resource.address)}
        target="_blank"
        rel="noreferrer"
        class="action-btn action-btn-secondary"
        aria-label={`Open directions to ${resource.name} in your map app`}
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="3 11 22 2 13 21 11 11 3 3 3 11"/>
          <path d="M13.5 8.5L19 2l1.5 8L23 16l-6-4-6 4 1.5 8z"/>
        </svg>
        Map
      </a>
    )}
    {hasWeb && (
      <a
        href={webUrl}
        target="_blank"
        rel="noreferrer"
        class="action-btn action-btn-secondary"
        aria-label={`${webLabel} for ${resource.name}`}
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        {webLabel}
      </a>
    )}
  </div>

  <!-- Mobile: per-card map link -->
  {canNavigate && (
    <a
      href={directionsHref(resource.address)}
      target="_blank"
      rel="noreferrer"
      class="card-map-link"
      aria-label={`Open directions to ${resource.name} in your map app`}
    >
      Open in Maps →
    </a>
  )}

  <!-- Footer: status + report + verified -->
  <footer class="resource-card-footer">
    <div class="resource-card-footer-left">
      {resource.nextAvail && (
        <StatusBadge avail={resource.nextAvail} class="status-badge" />
      )}
      <span class="resource-card-verified">
        Verified {verifiedDate}
      </span>
    </div>
    <button
      type="button"
      class="resource-card-report report-issue-btn"
      data-resource-id={resource.id}
      data-resource-name={resource.name}
      aria-label={`Report an issue with ${resource.name}`}
    >
      Report an issue
    </button>
  </footer>

</article>