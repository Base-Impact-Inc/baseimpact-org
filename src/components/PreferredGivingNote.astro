---
// Preferred-giving note (funds or items) — warm callout.
// Shared by /donate and /wishlist. The exact polished wording is set here
// so both pages stay in sync; only this file changes the note text.
const NOTE =
  "If possible, we prefer funds or items — they let us make the most impact on immediate needs, guided by what we hear directly from the people we serve.";
---

<aside class="preferred-giving-note">
  <p>{NOTE}</p>
</aside>
