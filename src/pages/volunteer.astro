---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Volunteer — Base Impact', description: 'Volunteer with Base Impact to help neighbors get connected and help small nonprofits keep their technology working.', ignoreTitleTemplate: true }}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="max-w-2xl">
      <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white">Volunteer</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">
        Base Impact runs on volunteer energy. If you have skills to share — or just want to help — we'd love to have you.
      </p>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Ways to volunteer</h2>
      <ul class="mt-4 list-disc pl-5 space-y-2 text-gray-600 dark:text-slate-300">
        <li><strong>Tech setup</strong> — Help neighbors set up devices, internet, and accounts.</li>
        <li><strong>Digital skills training</strong> — Walk people through housing portals, job applications, and benefits.</li>
        <li><strong>Nonprofit support</strong> — Help small community groups with security, backups, and basic IT.</li>
        <li><strong>Resource verification</strong> — Visit local organizations and confirm what services they offer.</li>
        <li><strong>Directory maintenance</strong> — Help keep resource listings accurate and up to date.</li>
      </ul>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">No experience needed</h2>
      <p class="mt-2 text-gray-600 dark:text-slate-300">
        We'll train you. What matters most is patience, kindness, and a willingness to help.
      </p>

      <a href="/contact" class="mt-6 inline-flex items-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
        Get involved
      </a>
    </div>
  </section>
</Layout>
