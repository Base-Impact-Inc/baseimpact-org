---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="py-24 bg-page min-h-[60vh] flex items-center justify-center">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <div class="font-display text-9xl font-bold text-electric-blue/20 mb-4">404</div>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-body mb-4">Page not found</h1>
      <p class="text-lg text-muted mb-8">Sorry, we couldn't find that page. It may have been moved or doesn't exist.</p>
      
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-electric-blue px-6 py-3 text-sm font-semibold text-on-fill hover:bg-electric-blue/90 transition-colors">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Go home
        </a>
        <a href="/directory" class="inline-flex items-center gap-2 rounded-xl bg-fill px-6 py-3 text-sm font-semibold text-on-fill hover:bg-fill-hover transition-colors">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
          Find help near you
        </a>
      </div>

      <div class="mt-12 pt-8 border-t border-line">
        <p class="text-sm text-faint mb-2">Need immediate help?</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="tel:211" class="inline-flex items-center gap-2 rounded-xl bg-electric-blue px-4 py-2 text-sm font-semibold text-on-fill hover:bg-electric-blue/90 transition-colors">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call 211 — 24/7
          </a>
          <a href="tel:988" class="inline-flex items-center gap-2 rounded-xl bg-fill px-4 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover transition-colors">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>
            Crisis 988 — 24/7
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
