---
import Base from '../layouts/Base.astro';
import { SOCIALS } from '../lib/socials';
---

<Base title="Connect — Base Impact" description="Connect with Base Impact — find us on social media, get in touch, and stay updated.">
  <div class="picture-band">
    <img src="/assets/community-volunteers.jpg" alt="Community volunteers working together" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Connect</h1>
  <div class="max-w-2xl space-y-6 text-muted leading-relaxed fade-in">
    <p>Stay in touch with Base Impact. We'd love to hear from you.</p>
    <h2 class="font-display text-xl font-semibold text-body mt-6">Contact</h2>
    <ul class="list-disc pl-5 space-y-2">
      <li><strong>Phone:</strong> <a href="tel:+13213230999" class="text-accent font-semibold">(321) 323-0999</a> — call or text, by appointment only</li>
      <li><strong>Email:</strong> <a href="mailto:admin@baseimpact.org" class="text-accent font-semibold">admin@baseimpact.org</a></li>
      <li><strong>Location:</strong> Scottsmoor, FL 32775 · Brevard County</li>
    </ul>
    <h2 class="font-display text-xl font-semibold text-body mt-6">Social media</h2>
    <p class="mb-4">Follow us for updates on new resources, events, and opportunities to get involved.</p>
    <ul class="space-y-2">
      {SOCIALS.map((s) => (
        <li>
          <strong>{s.name}:</strong>{' '}
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-accent font-semibold">{s.handle}</a>
          <span class="text-faint"> — {s.blurb}</span>
        </li>
      ))}
    </ul>
    <p class="text-sm text-faint mt-4">Instagram is being set up and will be linked here once it is live.</p>
    <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Contact us</a>
  </div>
</Base>
