---
export const prerender = false;

import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';

const runtime = (Astro.locals as any)?.runtime;
const env = runtime?.env;
let resources: any[] = [];
if (env?.baseimpact_verify) {
  const result = await env.baseimpact_verify.prepare('SELECT * FROM resources ORDER BY name ASC').all();
  resources = (result.results || []).map((row: any) => ({
    id: row.id,
    name: row.name,
    category: row.category,
    address: row.address,
    lat: row.lat,
    lng: row.lng,
    phone: row.phone,
    website: row.website || undefined,
    serviceUrl: row.service_url || undefined,
    sourceUrl: row.source_url || undefined,
    description: row.description,
    hoursText: row.hours_text,
    schedule: JSON.parse(row.schedule || '{}'),
    tags: JSON.parse(row.tags || '[]'),
    partnerType: row.partner_type,
    capacityStatus: row.capacity_status,
    group: row.help_group,
    services: JSON.parse(row.services || '[]'),
    county: row.county,
    lastVerified: row.last_verified || undefined,
    mobileOnly: row.mobile_only === 1,
    nextAvail: { status: 'UNKNOWN' },
  }));
} else {
  // Fallback for dev/preview without D1 binding
  const { processResources } = await import('../lib/resources/logic');
  const origin = { lat: 28.0836, lng: -80.6081 };
  resources = processResources(origin, 50, { category: 'All', tag: 'All', query: '', onlySaved: false, savedIds: [] });
}

const groups = ['all', 'food', 'shelter', 'health', 'money', 'basics', 'crisis', 'saved'];
const groupLabels: Record<string, string> = {
  all: 'All', food: 'Food', shelter: 'Shelter', health: 'Health',
  money: 'Money', basics: 'Basics', crisis: 'Crisis', saved: 'Saved',
};
---

<Base>
  <div class="mb-6">
    <h1 class="font-display text-3xl font-semibold text-body mb-2">Find Help</h1>
    <p class="text-muted mb-4">{resources.length} resources in Brevard County, FL</p>

    <div class="relative mb-4">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" id="search-input" placeholder="Search food, shelter, health..."
        class="w-full rounded-xl border border-line bg-card pl-10 pr-4 py-3 text-body placeholder:text-faint" />
    </div>

    <div class="chip-row mb-4" id="filter-chips">
      {groups.map((g) => (
        <button type="button" data-group={g}
          class={`chip px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap ${g === 'all' ? 'bg-fill text-on-fill' : 'bg-inset text-body hover:bg-line'}`}>
          {groupLabels[g]}
        </button>
      ))}
    </div>

    <label class="flex items-center gap-2 text-sm text-muted cursor-pointer">
      <input type="checkbox" id="open-now" class="rounded" />
      Open now
    </label>
  </div>

  <div class="flex gap-2 mb-4" id="view-toggle">
    <button type="button" id="view-list" class="chip px-4 py-2 rounded-full text-sm font-semibold bg-fill text-on-fill">List</button>
    <button type="button" id="view-map" class="chip px-4 py-2 rounded-full text-sm font-semibold bg-inset text-body hover:bg-line">Map</button>
  </div>

  <div id="map-legend" class="hidden flex flex-wrap gap-2 mb-3">
    {['all','food','shelter','health','money','basics','crisis'].map(g => (
      <button type="button" data-mapgroup={g} class={`map-legend-chip px-3 py-1.5 rounded-full text-xs font-semibold ${g === 'all' ? 'bg-fill text-on-fill' : 'bg-inset text-body hover:bg-line'}`}>
        {g.charAt(0).toUpperCase() + g.slice(1)}
      </button>
    ))}
  </div>

  <div id="map-container" class="hidden mb-4 rounded-2xl overflow-hidden shadow-[var(--shadow-border)]" style="height: 480px;"></div>

  <p id="results-count" class="text-sm text-muted mb-4">{resources.length} results</p>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 items-stretch" id="resource-grid">
    {resources.map((r: any) => (
      <div class="resource-item h-full" data-resource-id={r.id} data-group={r.group} data-name={r.name.toLowerCase()} data-desc={r.description.toLowerCase()} data-tags={r.tags.join(' ').toLowerCase()} data-open={r.nextAvail?.status === 'OPEN' ? '1' : '0'}>
        <ResourceCard resource={r} />
      </div>
    ))}
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>

  <script type="application/json" id="resource-data">
    {JSON.stringify(resources.map((r: any) => ({ id: r.id, name: r.name, lat: r.lat, lng: r.lng, address: r.address, category: r.category, group: r.group })))}
  </script>

  <div id="empty-state" class="hidden text-center py-12">
    <p class="text-lg text-muted">No resources found.</p>
    <p class="text-sm text-faint mt-2">Try a different search or filter.</p>
  </div>

  <div class="mt-8 rounded-2xl bg-inset p-6 text-center">
    <p class="text-sm text-muted mb-2">Need immediate help?</p>
    <div class="flex gap-2 justify-center flex-wrap">
      <a href="tel:211" class="inline-flex items-center gap-1 rounded-lg bg-fill px-4 py-2 text-sm font-semibold text-on-fill">Call 211</a>
      <a href="tel:988" class="inline-flex items-center gap-1 rounded-lg bg-fill-caution px-4 py-2 text-sm font-semibold text-on-fill">Crisis 988</a>
    </div>
  </div>
</Base>

<script>
  const searchInput = document.getElementById('search-input');
  const openNowCheckbox = document.getElementById('open-now');
  const chips = document.querySelectorAll('#filter-chips button');
  const items = document.querySelectorAll('.resource-item');
  const countEl = document.getElementById('results-count');
  const emptyState = document.getElementById('empty-state');
  const grid = document.getElementById('resource-grid');

  let activeGroup = 'all';

  function filter() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const openOnly = openNowCheckbox?.checked || false;
    let visible = 0;

    items.forEach(item => {
      const el = item;
      const group = el.dataset.group || '';
      const name = el.dataset.name || '';
      const desc = el.dataset.desc || '';
      const tags = el.dataset.tags || '';
      const isOpen = el.dataset.open === '1';

      const matchesGroup = activeGroup === 'all' || group === activeGroup || (activeGroup === 'saved' && getSaved().includes(el.getAttribute('data-resource-id') || ''));
      const matchesSearch = !query || name.includes(query) || desc.includes(query) || tags.includes(query);
      const matchesOpen = !openOnly || isOpen;

      if (matchesGroup && matchesSearch && matchesOpen) {
        el.style.display = '';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });

    if (countEl) countEl.textContent = visible + ' result' + (visible !== 1 ? 's' : '');
    if (emptyState && grid) {
      emptyState.classList.toggle('hidden', visible > 0);
      grid.classList.toggle('hidden', visible === 0);
    }
  }

  searchInput?.addEventListener('input', filter);
  openNowCheckbox?.addEventListener('change', filter);

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      activeGroup = chip.getAttribute('data-group') || 'all';
      chips.forEach(c => {
        c.classList.remove('bg-fill', 'text-on-fill');
        c.classList.add('bg-inset', 'text-body');
      });
      chip.classList.remove('bg-inset', 'text-body');
      chip.classList.add('bg-fill', 'text-on-fill');
      filter();
    });
  });

  // Copy address to clipboard
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('.copy-addr-btn');
    if (!btn) return;
    const addr = btn.getAttribute('data-copy-address') || '';
    try {
      await navigator.clipboard.writeText(addr);
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    } catch {
      btn.textContent = 'Copy failed';
      setTimeout(() => { btn.textContent = 'Copy address'; }, 1500);
    }
  });
  const SAVED_KEY = 'baseimpact-saved';
  function getSaved() {
    try { return JSON.parse(localStorage.getItem(SAVED_KEY) || '[]'); } catch { return []; }
  }
  function setSaved(ids) {
    localStorage.setItem(SAVED_KEY, JSON.stringify(ids));
  }
  function updateSaveBtn(btn, saved) {
    btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
    btn.classList.toggle('text-accent', saved);
    btn.classList.toggle('text-muted', !saved);
    const svg = btn.querySelector('svg');
    if (svg) svg.setAttribute('fill', saved ? 'currentColor' : 'none');
  }

  // Initialize saved state on page load
  const savedIds = getSaved();
  document.querySelectorAll('.save-btn').forEach(btn => {
    const id = btn.getAttribute('data-resource-id');
    if (id && savedIds.includes(id)) {
      updateSaveBtn(btn, true);
    }
  });

  // Handle save button clicks
  document.querySelectorAll('.save-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const id = btn.getAttribute('data-resource-id');
      if (!id) return;
      const current = getSaved();
      const idx = current.indexOf(id);
      if (idx >= 0) {
        current.splice(idx, 1);
        updateSaveBtn(btn, false);
      } else {
        current.push(id);
        updateSaveBtn(btn, true);
      }
      setSaved(current);
    });
  });

  // Map view (Leaflet)
  const viewListBtn = document.getElementById('view-list');
  const viewMapBtn = document.getElementById('view-map');
  const mapContainer = document.getElementById('map-container');
  const resourceGrid = document.getElementById('resource-grid');
  const mapLegend = document.getElementById('map-legend');
  let map = null;
  let markers = [];

  function initMap() {
    if (map) return;
    const dataEl = document.getElementById('resource-data');
    if (!dataEl || typeof L === 'undefined') return;
    let data = [];
    try { data = JSON.parse(dataEl.textContent || '[]'); } catch { data = []; }
    map = L.map('map-container').setView([28.0836, -80.6081], 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);
    data.forEach(r => {
      if (typeof r.lat !== 'number' || typeof r.lng !== 'number') return;
      const m = L.marker([r.lat, r.lng]).addTo(map);
      m.bindPopup('<strong>' + r.name + '</strong><br/>' + r.address + '<br/><a href="https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(r.address) + '&travelmode=transit" target="_blank" rel="noreferrer">Bus directions</a>');
      m._group = r.group;
      markers.push(m);
    });
  }

  function filterMap(group) {
    markers.forEach(m => {
      if (group === 'all' || m._group === group) {
        if (map && !map.hasLayer(m)) m.addTo(map);
      } else {
        if (map && map.hasLayer(m)) map.removeLayer(m);
      }
    });
    // update legend chip styles
    mapLegend?.querySelectorAll('.map-legend-chip').forEach(chip => {
      const g = chip.getAttribute('data-mapgroup');
      if (g === group) {
        chip.classList.add('bg-fill','text-on-fill');
        chip.classList.remove('bg-inset','text-body');
      } else {
        chip.classList.remove('bg-fill','text-on-fill');
        chip.classList.add('bg-inset','text-body');
      }
    });
  }

  function showList() {
    mapContainer?.classList.add('hidden');
    mapLegend?.classList.add('hidden');
    resourceGrid?.classList.remove('hidden');
    viewListBtn?.classList.add('bg-fill','text-on-fill');
    viewListBtn?.classList.remove('bg-inset','text-body');
    viewMapBtn?.classList.remove('bg-fill','text-on-fill');
    viewMapBtn?.classList.add('bg-inset','text-body');
  }
  function showMap() {
    mapContainer?.classList.remove('hidden');
    mapLegend?.classList.remove('hidden');
    resourceGrid?.classList.add('hidden');
    viewMapBtn?.classList.add('bg-fill','text-on-fill');
    viewMapBtn?.classList.remove('bg-inset','text-body');
    viewListBtn?.classList.remove('bg-fill','text-on-fill');
    viewListBtn?.classList.add('bg-inset','text-body');
    if (typeof L === 'undefined') { setTimeout(showMap, 200); return; }
    initMap();
    setTimeout(() => { if (map) map.invalidateSize(); }, 100);
  }

  viewListBtn?.addEventListener('click', showList);
  viewMapBtn?.addEventListener('click', showMap);
  mapLegend?.querySelectorAll('.map-legend-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      filterMap(chip.getAttribute('data-mapgroup') || 'all');
    });
  });
</script>