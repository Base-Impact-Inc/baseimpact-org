---
/**
 * Resource directory — live from Cloudflare D1.
 *
 * `prerender = false` because the listing is read per request from the database;
 * if D1 is unreachable the loader falls back to the bundled snapshot so the
 * page can never render empty.
 */
import Base from '../layouts/Base.astro';
import DirectoryApp from '../components/DirectoryApp.astro';
import { loadResources } from '../lib/resources/load';
import { processResources } from '../lib/resources/logic';

export const prerender = false;

const { resources, source } = await loadResources();

const origin = { lat: 28.0836, lng: -80.6081 };
const processed = processResources(origin, 200, {
  category: 'All',
  tag: 'All',
  query: '',
  onlySaved: false,
  savedIds: [],
  openNow: false,
});

// Closest first: a person looking for help cares about distance before anything else.
processed.sort((a, b) => a.distanceMiles - b.distanceMiles);
---

<Base
  title="Find food, shelter, and help near you"
  description="Search verified food pantries, shelters, showers, health care, and assistance across Brevard, Volusia, Orange, and statewide Florida — sorted by distance from you."
>
  <DirectoryApp locale="en" resources={processed} source={source} />
</Base>
