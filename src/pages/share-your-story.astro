---
import Base from '../layouts/Base.astro';
---

<Base title="Share Your Story — Base Impact" description="Tell us how Base Impact helped you. With your permission, we'll feature your story.">
  <div class="max-w-2xl mx-auto">
    <h1 class="font-display text-3xl font-semibold text-body mb-4">Share your story</h1>
    <p class="text-muted leading-relaxed mb-6">
      Did Base Impact help you? Tell us how. With your permission, we'll feature your story on our website to inspire others and show the real impact of community support.
    </p>

    <form id="storyForm" class="space-y-5">
      <div>
        <label for="story-name" class="block text-sm font-medium text-muted mb-1">Your name (or "Anonymous")</label>
        <input type="text" id="story-name" name="name" required
          class="w-full rounded-lg border border-line bg-card px-4 py-2.5 text-body placeholder:text-muted/50 focus:border-accent focus:outline-none"
          placeholder="Jane D." />
      </div>

      <div>
        <label for="story-email" class="block text-sm font-medium text-muted mb-1">Email (for verification only — never published)</label>
        <input type="email" id="story-email" name="email" required
          class="w-full rounded-lg border border-line bg-card px-4 py-2.5 text-body placeholder:text-muted/50 focus:border-accent focus:outline-none"
          placeholder="jane@example.com" />
      </div>

      <div>
        <label for="story-text" class="block text-sm font-medium text-muted mb-1">How did Base Impact help you?</label>
        <textarea id="story-text" name="story" required rows="6"
          class="w-full rounded-lg border border-line bg-card px-4 py-2.5 text-body placeholder:text-muted/50 focus:border-accent focus:outline-none resize-y"
          placeholder="Base Impact helped me by..."></textarea>
      </div>

      <div class="flex items-start gap-3">
        <input type="checkbox" id="story-consent" name="consent" required
          class="mt-1 h-4 w-4 rounded border-line accent-accent" />
        <label for="story-consent" class="text-sm text-muted leading-relaxed">
          I give Base Impact permission to publish my story on their website and social media.
          I understand my email will never be shared publicly. I can request removal at any time
          by contacting Base Impact at <a href="tel:+13213230999" class="text-accent hover:underline">(321) 323-0999</a>.
        </label>
      </div>

      <button type="submit" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-6 py-2.5 text-sm font-semibold text-on-fill hover:bg-fill-hover">
        Submit your story
      </button>

      <p id="form-status" class="text-sm text-accent font-medium" style="display: none;"></p>
    </form>

    <div class="mt-8 rounded-lg border border-line bg-card p-5">
      <h2 class="font-display text-lg font-semibold text-body mb-2">What happens next?</h2>
      <ul class="list-disc pl-5 space-y-1 text-sm text-muted">
        <li>We review your submission within a few days.</li>
        <li>If we feature your story, we'll contact you first for final approval.</li>
        <li>Your name can be displayed or kept anonymous — your choice.</li>
        <li>You can request removal at any time, no questions asked.</li>
      </ul>
    </div>
  </div>

  <script>
    const form = document.getElementById('storyForm');
    const status = document.getElementById('form-status');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch('/api/stories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (res.ok) {
            status.style.display = 'block';
            status.textContent = 'Thank you! Your story has been submitted for review. We\'ll reach out if we feature it.';
            form.reset();
          } else {
            status.style.display = 'block';
            status.textContent = result.error || 'Something went wrong. Please try again.';
          }
        } catch {
          status.style.display = 'block';
          status.textContent = 'Something went wrong. Please try again or call (321) 323-0999.';
        }
        status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }
  </script>
</Base>