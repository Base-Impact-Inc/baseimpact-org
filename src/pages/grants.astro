---
import Base from '../layouts/Base.astro';
---

<Base
  title="Grants &amp; Funding — Base Impact"
  description="Funding opportunities, impact metrics, and budget transparency for Base Impact Inc. — a Florida nonprofit corporation serving Brevard County, FL."
>
  <div class="picture-band">
    <img src="/assets/homeless-shelter-community.jpg" alt="Community shelter providing a safe place for those in need" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Grants &amp; Funding</h1>
  <p class="max-w-2xl text-muted leading-relaxed mb-8 fade-in">
    Base Impact Inc. is a Florida nonprofit corporation registered in Brevard County, FL. We're seeking
    grants, sponsorships, and partnerships to expand our technology access, cold-weather, and digital
    skills programs. This page is for funders, reviewers, and partners evaluating our work.
  </p>

  <!-- Mission for funders -->
  <section class="mb-10 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body mb-3">Our mission</h2>
    <p class="text-muted leading-relaxed max-w-3xl">
      To help neighbors get connected — devices, internet, and the skills to use them — and to help small
      nonprofits keep their technology working. We focus on practical, hands-on support: refurbished devices,
      service applications, one-on-one training, and community resource navigation. We work alongside —
      not in competition with — the local organizations we serve.
    </p>
  </section>

  <!-- Impact metrics -->
  <section class="mb-10 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body mb-3">Impact to date</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)] text-center">
        <p class="font-display text-3xl font-bold text-body">136</p>
        <p class="text-sm text-muted mt-1">Local resources listed</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)] text-center">
        <p class="font-display text-3xl font-bold text-body">7</p>
        <p class="text-sm text-muted mt-1">Core programs</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)] text-center">
        <p class="font-display text-3xl font-bold text-body">3</p>
        <p class="text-sm text-muted mt-1">Counties with resource data</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)] text-center">
        <p class="font-display text-3xl font-bold text-body">2</p>
        <p class="text-sm text-muted mt-1">Languages (EN / ES)</p>
      </div>
    </div>
    <p class="text-xs text-faint mt-3">Metrics updated as programs grow. Contact us for the latest figures and case studies.</p>
  </section>

  <!-- Funding needs -->
  <section class="mb-10 space-y-4 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body">Current funding needs</h2>
    <div class="space-y-3">
      <article class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body">Cold-weather supplies</h3>
        <p class="text-sm text-muted leading-relaxed">Heavier jackets, hoodies, blankets, socks, gloves, and hygiene kits for extended cold-night shelter stays and community distribution.</p>
      </article>
      <article class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body">Devices &amp; connectivity</h3>
        <p class="text-sm text-muted leading-relaxed">Refurbished phones, tablets, and laptops; Wi-Fi hotspots; data plans for neighbors without service.</p>
      </article>
      <article class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body">Training &amp; support</h3>
        <p class="text-sm text-muted leading-relaxed">One-on-one digital skills sessions, job/housing portal walk-throughs, and small-nonprofit IT support.</p>
      </article>
      <article class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body">AI &amp; infrastructure</h3>
        <p class="text-sm text-muted leading-relaxed">AI-capable hardware to run local models for form filling, document understanding, and tech troubleshooting — privately, on-device.</p>
      </article>
    </div>
  </section>

  <!-- Budget transparency -->
  <section class="mb-10 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body mb-3">Budget transparency</h2>
    <p class="text-muted leading-relaxed max-w-3xl mb-3">
      We believe funders deserve clarity. Detailed financials, including how donations and grants are used,
      are available on our <a href="/financials" class="text-accent font-semibold">Financials page</a>.
      We can provide itemized budgets, receipts, and outcome reports for any grant or sponsorship.
    </p>
  </section>

  <!-- How to fund / partner -->
  <section class="mb-10 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body mb-3">How to support</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body mb-1">Donate</h3>
        <p class="text-sm text-muted leading-relaxed mb-3">One-time or recurring gifts fund devices, supplies, and training directly.</p>
        <a href="/donate" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-4 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Donate</a>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body mb-1">Grant / sponsor</h3>
        <p class="text-sm text-muted leading-relaxed mb-3">We welcome grant applications and corporate sponsorships. Contact us for a proposal.</p>
        <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-4 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Contact us</a>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body mb-1">Partner</h3>
        <p class="text-sm text-muted leading-relaxed mb-3">Organizations serving Brevard County can co-deliver programs and share resources.</p>
        <a href="/partners" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-4 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Partners</a>
      </div>
    </div>
  </section>

  <!-- Download one-pager -->
  <section class="mb-10 fade-in">
    <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="font-display text-xl font-semibold text-body mb-1">One-pager for funders</h2>
        <p class="text-sm text-muted">A single-page summary of our mission, impact, programs, and funding needs — ready to share with reviewers.</p>
      </div>
      <a href="/base-impact-one-pager.pdf" target="_blank" rel="noreferrer"
        class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover shrink-0">
        Download PDF
      </a>
    </div>
  </section>
  <section class="rounded-2xl bg-band p-6 text-on-fill fade-in">
    <h2 class="font-display text-xl font-semibold mb-2">Grant &amp; funding inquiries</h2>
    <p class="text-sm opacity-90 mb-4">
      For grant applications, budget documents, or partnership discussions, reach out directly.
      We respond within a few business days.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="mailto:admin@baseimpact.org" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Email admin@baseimpact.org</a>
      <a href="tel:+13213230999" class="inline-flex min-h-11 items-center rounded-lg border border-line bg-card/20 px-5 py-2 text-sm font-semibold text-on-fill hover:bg-card/40">Call (321) 323-0999</a>
    </div>
  </section>
</Base>
