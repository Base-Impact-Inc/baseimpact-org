---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Grants & Funding — Base Impact', description: 'Funding opportunities, impact metrics, and budget transparency for Base Impact Inc.', ignoreTitleTemplate: true }}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="max-w-3xl">
      <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white">Grants & Funding</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">
        Base Impact Inc. is a pre-filing nonprofit in Scottsmoor, FL, serving Brevard County. We're seeking
        grants, sponsorships, and partnerships to expand our technology access, cold-weather, and digital
        skills programs.
      </p>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Our mission</h2>
      <p class="mt-2 text-gray-600 dark:text-slate-300">
        To help neighbors get connected — devices, internet, and the skills to use them — and to help small
        local nonprofits keep their technology working, so that everyone in Brevard County can access the
        resources they need.
      </p>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">What we do</h2>
      <ul class="mt-2 list-disc pl-5 space-y-2 text-gray-600 dark:text-slate-300">
        <li>Provide refurbished devices to neighbors in need</li>
        <li>Help with internet service applications and subsidies</li>
        <li>Digital skills training for housing, jobs, and benefits</li>
        <li>Free tech support for small community organizations</li>
        <li>Maintain a local resource directory (83+ resources)</li>
      </ul>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Impact</h2>
      <div class="mt-4 grid grid-cols-2 gap-4">
        <div class="rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700 text-center">
          <p class="font-heading text-3xl font-bold text-blue-600 dark:text-blue-400">83</p>
          <p class="text-sm text-gray-600 dark:text-slate-300 mt-1">Resources listed</p>
        </div>
        <div class="rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700 text-center">
          <p class="font-heading text-3xl font-bold text-blue-600 dark:text-blue-400">6</p>
          <p class="text-sm text-gray-600 dark:text-slate-300 mt-1">Service types covered</p>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-blue-50 dark:bg-slate-800 p-6">
        <h3 class="font-heading text-xl font-semibold text-gray-900 dark:text-white">Interested in partnering?</h3>
        <p class="mt-2 text-gray-600 dark:text-slate-300">
          We'd love to discuss how we can work together. Reach out at <a href="mailto:info@baseimpact.org" class="text-blue-600 dark:text-blue-400 underline">info@baseimpact.org</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
