---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts.filter(p => p.data.featured);
const recent = posts.filter(p => !p.data.featured);
---

<Base title="Blog — Base Impact" description="Impact stories, resource spotlights, and community news from Base Impact.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Blog</h1>
  <p class="text-muted leading-relaxed mb-8 fade-in max-w-2xl">
    Impact stories, resource spotlights, volunteer highlights, and community news.
  </p>

  {featured.length > 0 && (
    <section class="mb-10 fade-in">
      <h2 class="font-display text-xl font-semibold text-body mb-4">Featured</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {featured.map(post => (
          <a href={`/blog/${post.id}`} class="group rounded-2xl bg-card shadow-[var(--shadow-border)] hover:shadow-lg transition-shadow overflow-hidden">
            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="w-full h-56 object-cover" loading="lazy" />
            )}
            <div class="p-6">
              <span class="text-xs font-semibold text-accent uppercase tracking-wide">Featured</span>
              <h3 class="font-display text-xl font-semibold text-body group-hover:text-accent transition-colors mt-2">{post.data.title}</h3>
              <p class="text-sm text-muted mt-2 line-clamp-3">{post.data.description}</p>
              <p class="text-xs text-faint mt-4">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                {post.data.categories.length > 0 && (
                  <span> · {post.data.categories.join(', ')}</span>
                )}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section class="fade-in">
      <h2 class="font-display text-xl font-semibold text-body mb-4">Recent posts</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {recent.map(post => (
          <a href={`/blog/${post.id}`} class="group block rounded-2xl bg-card shadow-[var(--shadow-border)] hover:shadow-lg transition-shadow overflow-hidden">
            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="w-full h-48 object-cover" loading="lazy" />
            )}
            <div class="p-5">
              <h3 class="font-display text-lg font-semibold text-body group-hover:text-accent transition-colors">{post.data.title}</h3>
              <p class="text-sm text-muted mt-1 line-clamp-3">{post.data.description}</p>
              <p class="text-xs text-faint mt-3">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                {post.data.categories.length > 0 && (
                  <span> · {post.data.categories.join(', ')}</span>
                )}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <p class="text-muted">No posts yet. Check back soon.</p>
  )}
</Base>
