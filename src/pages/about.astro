---
import Base from '@/layouts/Base.astro';

const metadata = {
  title: 'About Base Impact',
  description: 'Base Impact Inc. is a Florida nonprofit corporation helping neighbors get connected and small nonprofits keep their technology working in Brevard County.',
};
---

<Base title={metadata.title} description={metadata.description}>
  <section class="section">
    <div class="container max-w-3xl">
      <h1 class="text-4xl font-bold text-text-dark dark:text-darkmode-text-light mb-6">About Base Impact</h1>
      <div class="prose dark:prose-invert space-y-6 text-text dark:text-darkmode-text">
        <p>
          Base Impact Inc. is a Florida nonprofit corporation based in Scottsmoor, Brevard County.
          We help neighbors get connected — devices, internet, and the skills to use them — and we help
          small local nonprofits keep their technology working.
        </p>

        <h2 class="text-2xl font-bold text-text-dark dark:text-darkmode-text-light mt-8">Mission</h2>
        <p class="text-text-dark dark:text-darkmode-text-light font-semibold text-lg">
          To help neighbors get connected and help small local nonprofits keep their technology working,
          so that everyone in Brevard County can access the resources they need.
        </p>

        <h2 class="text-2xl font-bold text-text-dark dark:text-darkmode-text-light mt-8">Vision</h2>
        <p>
          A community where everyone has access to the technology, skills, and resources they need to thrive.
        </p>

        <h2 class="text-2xl font-bold text-text-dark dark:text-darkmode-text-light mt-8">Our Values</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Access for all</strong> — Everyone deserves a working device, internet, and the skills to use them.</li>
          <li><strong>Small groups matter</strong> — Churches, pantries, and community groups are the backbone of help.</li>
          <li><strong>Local first</strong> — We focus on Brevard County because that's where we live and serve.</li>
          <li><strong>Simple is better</strong> — Our resource directory works alongside 211, not instead of it.</li>
        </ul>

        <h2 class="text-2xl font-bold text-text-dark dark:text-darkmode-text-light mt-8">Our Story</h2>
        <p>
          Base Impact was founded to fill a gap: many neighbors in Brevard County need help accessing
          technology and resources, and many small nonprofits lack the technical support to keep their
          systems running. We started small — a laptop drive, a few hours of tech support — and grew into
          a statewide resource directory and community technology partnership.
        </p>
      </div>
    </div>
  </section>
</Base>
