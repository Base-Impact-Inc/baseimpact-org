---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'About Base Impact', description: 'Base Impact Inc. — a Florida nonprofit corporation helping neighbors get connected and small nonprofits keep their technology working in Brevard County.', ignoreTitleTemplate: true }}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="max-w-3xl">
      <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white">About Base Impact</h1>
      <div class="mt-6 space-y-6 text-gray-600 dark:text-slate-300 leading-relaxed">
        <p>
          Base Impact Inc. is a Florida nonprofit corporation based in Scottsmoor, Brevard County.
          We help neighbors get connected — devices, internet, and the skills to use them — and we help
          small local nonprofits keep their technology working.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Mission</h2>
        <p class="text-gray-900 dark:text-white font-medium">
          To help neighbors get connected and help small local nonprofits keep their technology working,
          so that everyone in Brevard County can access the resources they need.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Vision</h2>
        <p>
          A community where everyone has access to the technology, skills, and resources they need to thrive.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Our Values</h2>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Access for all</strong> — Everyone deserves a working device, internet, and the skills to use them.</li>
          <li><strong>Small groups matter</strong> — Churches, pantries, and community groups are the backbone of help.</li>
          <li><strong>Local first</strong> — We focus on Brevard County because that's where we live and serve.</li>
          <li><strong>Simple is better</strong> — Our resource directory works alongside 211, not instead of it.</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
