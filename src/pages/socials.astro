---
import Base from '../layouts/Base.astro';
import { SOCIALS, PENDING } from '../lib/socials';
---

<Base title="Socials — Base Impact" description="Follow Base Impact on social media for updates on resources, events, and community help in Brevard County, FL.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Socials</h1>
  <p class="text-muted leading-relaxed mb-8 fade-in max-w-2xl">
    Follow Base Impact for updates on new resources, events, volunteer calls, and opportunities
    to get involved. These are the accounts we actually run.
  </p>

  <div class="grid gap-4 sm:grid-cols-2 max-w-3xl">
    {SOCIALS.map((s) => (
      <a href={s.url} target="_blank" rel="noopener noreferrer"
         class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)] hover:border-accent transition-colors">
        <div class="flex items-center gap-3 mb-2">
          <span class="inline-flex size-9 items-center justify-center rounded-lg bg-band text-on-fill">
            {s.icon === 'x' ? (
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
              </svg>
            )}
          </span>
          <div>
            <p class="font-display text-base font-semibold" style="color: var(--color-body);">{s.name}</p>
            <p class="text-sm text-faint">{s.handle}</p>
          </div>
        </div>
        <p class="text-sm text-muted">{s.blurb}</p>
      </a>
    ))}
  </div>

  {PENDING.length > 0 && (
    <section class="mt-8 max-w-3xl fade-in">
      <h2 class="font-display text-xl font-semibold text-body mb-3">Being set up</h2>
      <ul class="flex flex-wrap gap-2">
        {PENDING.map((platform) => (
          <li class="rounded-full border border-line px-4 py-2 text-sm text-muted">{platform} — coming soon</li>
        ))}
      </ul>
      <p class="text-sm text-faint mt-4">
        We only link accounts that exist and are controlled by Base Impact. In the meantime,
        <a href="/contact" class="text-accent font-semibold">contact us</a> directly or call
        <a href="tel:+132****0999" class="text-accent font-semibold">(321) 323-0999</a>.
      </p>
    </section>
  )}
</Base>
