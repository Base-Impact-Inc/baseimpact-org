---
import Base from '@/layouts/Base.astro';

const metadata = {
  title: 'Donate — Base Impact',
  description: 'Support Base Impact with a donation. Your contribution helps neighbors get connected and small nonprofits keep their technology working.',
};
---

<Base title={metadata.title} description={metadata.description}>
  <section class="section">
    <div class="container max-w-3xl">
      <h1 class="text-4xl font-bold text-text-dark dark:text-darkmode-text-light mb-6">Donate</h1>
      <div class="prose dark:prose-invert space-y-6 text-text dark:text-darkmode-text">
        <p>
          Base Impact Inc. is a Florida nonprofit corporation. Your donation supports our mission to help
          neighbors get connected and small nonprofits keep their technology working.
        </p>

        <h2 class="text-2xl font-bold text-text-dark dark:text-darkmode-text-light mt-8">How to Donate</h2>
        <p>
          We are setting up online donation processing. In the meantime, you can support us by:
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li>Donating working devices (laptops, tablets, chargers)</li>
          <li>Volunteering your time as a Community Connector or Tech Keeper</li>
          <li>Sharing our resource directory with people who need it</li>
          <li>Hosting an event or connecting us with a partner organization</li>
        </ul>

        <p>
          If you would like to make a financial donation or have questions about giving, please contact us.
        </p>

        <a href="/contact" class="btn btn-primary mt-4 inline-block">Contact Us to Donate</a>
      </div>
    </div>
  </section>
</Base>
