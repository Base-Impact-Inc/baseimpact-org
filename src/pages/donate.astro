---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Donate — Base Impact', description: "Support Base Impact's mission to help neighbors get connected in Brevard County, FL.", ignoreTitleTemplate: true }}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="max-w-2xl">
      <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white">Donate</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">
        Base Impact is a pre-filing nonprofit. Your support helps us provide devices, internet service, digital skills training, and tech support to neighbors and small nonprofits in Brevard County.
      </p>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">What your donation supports</h2>
      <ul class="mt-4 list-disc pl-5 space-y-2 text-gray-600 dark:text-slate-300">
        <li><strong>Devices</strong> — Refurbished computers and tablets for neighbors who need them.</li>
        <li><strong>Internet access</strong> — Help with internet service applications and subsidies.</li>
        <li><strong>Training</strong> — One-on-one digital skills sessions for housing, jobs, and benefits.</li>
        <li><strong>Nonprofit tech support</strong> — Free setup and security for small community organizations.</li>
      </ul>

      <div class="mt-8 rounded-2xl bg-blue-600 dark:bg-blue-700 p-6 text-white">
        <h2 class="font-heading text-xl font-semibold mb-2">How to donate</h2>
        <p class="text-blue-100 mb-4">
          We're setting up secure donation processing. In the meantime, you can reach us at <a href="mailto:info@baseimpact.org" class="underline text-white">info@baseimpact.org</a>.
        </p>
        <p class="text-sm text-blue-200">
          Base Impact Inc. is a Florida nonprofit corporation. Pending 501(c)(3) approval.
        </p>
      </div>
    </div>
  </section>
</Layout>
