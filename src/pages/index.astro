---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

/**
 * Home — rebuilt on the Launchpad section grammar:
 * hero → statistics → topics → cards → belief → stories → donation.
 * Every word of mission copy and every listing figure is preserved from the
 * original page; stories are pulled live from the posts collection so the
 * impact section can never drift from what was actually published.
 */

const pillars = [
  {
    title: 'Technology access',
    body: 'Helping neighbors get a working device and internet service. Learn to use them.',
    href: '/technology-access',
    img: '/assets/device-repair-tech.jpg',
    alt: 'Hands repairing a laptop at a community tech session',
  },
  {
    title: 'Digital skills & job help',
    body: 'Walk-throughs for housing portals, job applications, benefits, and staying safe online.',
    href: '/programs',
    img: '/assets/tech-help-digital-skills.jpg',
    alt: 'One-on-one digital skills coaching at a keyboard',
  },
  {
    title: 'Tech for small nonprofits',
    body: 'Free setup, security, and support for churches, pantries, and 1–5 person community groups.',
    href: '/partners',
    img: '/assets/tech-support-session.jpg',
    alt: 'Volunteer helping a small nonprofit with its technology',
  },
  {
    title: 'Local resource guide',
    body: 'A simpler, local starting point. Food, shelter, showers, and more.',
    href: '/guide',
    img: '/assets/food-pantry-volunteers.jpg',
    alt: 'Volunteers organizing food at a local pantry',
  },
];

const stats = [
  { value: 136, suffix: '+', label: 'Resources listed' },
  { value: 6, suffix: '', label: 'Service types' },
  { value: 3, suffix: '', label: 'Counties covered' },
  { value: 24, suffix: '/7', label: 'Help available' },
];

const stories = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Base Impact. Find help, get connected.">
  <!-- ───────────────────────── HERO ───────────────────────── -->
  <section class="lp-hero rounded-5" style="margin-inline: -1rem;" data-reveal="fade">
    <div class="lp-hero-bg" style="background-image: url('/assets/warehouse-racking.jpg');" role="img" aria-label="Nonprofit warehouse racking being built for supply storage"></div>
    <div class="lp-hero-overlay"></div>

    <div class="lp-hero-content">
      <div class="px-6 py-16 sm:py-24">
        <p class="eyebrow" data-reveal="fade-up" data-delay="1">Base Impact · Brevard, Volusia &amp; Orange Counties</p>
        <h1 class="lp-hero-title mt-4" data-reveal="fade-up" data-delay="2">Help<span style="color: var(--color-accent);">.</span></h1>
        <p class="lp-hero-sub mt-5" data-reveal="fade-up" data-delay="3">
          Base Impact connects people with food, shelter, showers, and essentials — and helps small
          nonprofits keep their technology working.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal="fade-up" data-delay="4">
          <a href="/directory" class="btn btn-primary btn-xl">
            Find help near you
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="tel:211" class="btn btn-outline-light btn-xl">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call 211 — 24/7
          </a>
        </div>

        <!-- Emergency quick dial: never more than a tap away -->
        <div class="mt-10 flex flex-wrap gap-3" data-reveal="fade-up" data-delay="5">
          <a href="tel:211" class="lp-card" style="padding: 1rem 1.25rem; min-width: 11rem;">
            <span class="eyebrow">24/7 local help</span>
            <span class="block display-4 mt-2" style="font-size: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);">Call 211</span>
          </a>
          <a href="tel:+132****0999" class="lp-card" style="padding: 1rem 1.25rem; min-width: 11rem;">
            <span class="eyebrow">Base Impact · by appointment</span>
            <span class="block display-4 mt-2" style="font-size: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);">(321) 323-0999</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── STATISTICS ───────────────────────── -->
  <section class="py-vh-4" style="margin-inline: -1rem;">
    <div class="px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((s, i) => (
          <div data-reveal="zoom-in-up" data-delay={String(i + 1)}>
            <p class="stat-big">
              <span class="count-up" data-count-up={s.value} data-count-suffix={s.suffix}>0{s.suffix}</span>
            </p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── WHAT WE DO (ThreeTopics) ───────────────────────── -->
  <section class="py-vh-3">
    <div class="grid gap-8 md:grid-cols-2 md:items-start">
      <div data-reveal="fade-right">
        <span class="eyebrow">What we do</span>
        <h2 class="display-4 mt-3">
          Immediate needs first. Then the skills and tools that keep people housed,
          employed, and connected.
        </h2>
      </div>
      <div class="md:pt-2">
        {pillars.map((p, i) => (
          <div class="flex flex-col gap-1 py-5 border-t" style="border-color: var(--color-line);" data-reveal="fade-left" data-delay={String(i + 1)}>
            <a href={p.href} class="link-fancy text-lg font-semibold" style="align-self: flex-start;">{p.title}</a>
            <p class="text-muted" style="max-width: 52ch;">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────────────────── PROGRAM CARDS (FourCards) ───────────────────────── -->
  <section class="py-vh-3">
    <div class="section-heading">
      <span class="eyebrow">Where to start</span>
      <h2 class="section-title">Four ways we show up</h2>
      <p class="section-lead">Pick the door that matches what you need right now. Each one leads to real people, not a call centre.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p, i) => (
        <a href={p.href} class="lp-card group block" data-reveal="zoom-in-up" data-delay={String((i % 4) + 1)}>
          <div class="lp-card-media" style="aspect-ratio: 4 / 3;">
            <img src={p.img} alt={p.alt} loading="lazy" decoding="async" width="800" height="600" />
          </div>
          <div class="pt-4">
            <h3 class="text-lg font-semibold" style="color: var(--color-body);">{p.title}</h3>
            <p class="text-sm text-muted mt-2">{p.body}</p>
            <span class="link-fancy-accent link-fancy inline-flex items-center gap-1 text-sm font-medium mt-3">
              Learn more
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────────────────────── BELIEF STATEMENT ───────────────────────── -->
  <section class="py-vh-3">
    <div class="rounded-5 gradient p-8 sm:p-12" data-reveal="zoom-in">
      <p class="display-4" style="max-width: 24ch; color: #fff;">
        We believe everyone deserves a working device, a working connection, and someone to show them how.
      </p>
    </div>
  </section>

  <!-- STORIES — live from the posts collection -->
  <section class="py-vh-4">
    <div class="section-heading flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Impact in real life</span>
        <h2 class="section-title">Stories from the neighborhood</h2>
      </div>
      <a href="/blog" class="btn btn-outline-light">All stories</a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {stories.map((story, i) => (
        <article class="lp-card flex flex-col" data-reveal="zoom-in-up" data-delay={String(i + 1)}>
          {story.data.image && (
            <div class="lp-card-media" style="aspect-ratio: 16 / 10;">
              <img src={story.data.image} alt="" loading="lazy" decoding="async" width="800" height="500" />
            </div>
          )}
          <div class="pt-4 flex-1 flex flex-col">
            <h3 class="text-lg font-semibold" style="color: var(--color-body);">{story.data.title}</h3>
            {story.data.description && (
              <p class="text-sm text-muted mt-2 flex-1">{story.data.description}</p>
            )}
            <a href={`/blog/${story.id}`} class="link-fancy-accent link-fancy text-sm font-medium mt-4" style="align-self: flex-start;">
              Read the story
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ───────────────────────── DONATE ───────────────────────── -->
  <section class="py-vh-5" style="margin-inline: -1rem;">
    <div class="px-4 sm:px-6 text-center">
      <p class="display-huge" data-reveal="fade-up">Donate</p>
      <p class="section-lead mx-auto" style="text-align: center;" data-reveal="fade-up" data-delay="1">
        Help us keep connecting people with the resources they need.
      </p>
      <div class="mt-6" data-reveal="fade-up" data-delay="2">
        <a href="/donate" class="btn btn-light btn-xl">Give now</a>
      </div>
      <p class="text-sm text-faint mt-6" data-reveal="fade-up" data-delay="3">
        Base Impact Inc. is a Florida nonprofit corporation. Donations are not currently tax-deductible while 501(c)(3) status is pending.
      </p>
    </div>
  </section>
</Base>
