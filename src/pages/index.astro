---
import Base from '@/layouts/Base.astro';

const metadata = {
  title: 'Base Impact — Connecting Neighbors, Empowering Nonprofits',
  description: 'Base Impact Inc. is a Florida nonprofit corporation helping neighbors get connected and small nonprofits keep their technology working in Brevard County.',
};
---

<Base title={metadata.title} description={metadata.description}>
  <!-- Hero -->
  <section class="section pt-24 pb-16">
    <div class="container text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-text-dark dark:text-darkmode-text-light mb-6">
        Connecting Neighbors,<br />
        <span class="text-primary">Empowering Nonprofits</span>
      </h1>
      <p class="max-w-2xl mx-auto text-lg text-text dark:text-darkmode-text mb-8">
        We help neighbors get connected — devices, internet, and the skills to use them — and we help
        small local nonprofits keep their technology working in Brevard County.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/directory" class="btn btn-primary">Find Resources</a>
        <a href="/about" class="btn btn-outline">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section bg-light dark:bg-darkmode-body">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-6">
          <div class="text-4xl font-bold text-primary mb-2">83</div>
          <div class="text-text dark:text-darkmode-text">Resources Listed</div>
        </div>
        <div class="p-6">
          <div class="text-4xl font-bold text-primary mb-2">4</div>
          <div class="text-text dark:text-darkmode-text">Counties Served</div>
        </div>
        <div class="p-6">
          <div class="text-4xl font-bold text-primary mb-2">6</div>
          <div class="text-text dark:text-darkmode-text">Service Types</div>
        </div>
        <div class="p-6">
          <div class="text-4xl font-bold text-primary mb-2">100%</div>
          <div class="text-text dark:text-darkmode-text">Community Focused</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <h2 class="text-3xl font-bold text-center text-text-dark dark:text-darkmode-text-light mb-12">
        What We Do
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Resource Directory</h3>
          <p class="text-text dark:text-darkmode-text">83 verified resources across Brevard, Volusia, Orange, and Statewide counties.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Device Access</h3>
          <p class="text-text dark:text-darkmode-text">Helping neighbors get connected with devices, internet, and digital skills.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Nonprofit Support</h3>
          <p class="text-text dark:text-darkmode-text">Keeping small nonprofits' technology working so they can focus on their mission.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-primary text-white">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-4">Need Help Finding Resources?</h2>
      <p class="max-w-xl mx-auto mb-8 text-white/90">
        Our directory connects you with 83 verified resources across Central Florida.
      </p>
      <a href="/directory" class="btn bg-white text-primary hover:bg-gray-100">
        Browse Directory
      </a>
    </div>
  </section>
</Base>
