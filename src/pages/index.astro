---
import Base from '../layouts/Base.astro';

const pillars = [
  { title: "Technology access", body: "Helping neighbors get a working device and internet service. Learn to use them." },
  { title: "Digital skills & job help", body: "Walk-throughs for housing portals, job applications, benefits, and staying safe online." },
  { title: "Tech for small nonprofits", body: "Free setup, security, and support for churches, pantries, and 1–5 person community groups." },
  { title: "Local resource guide", body: "A simpler, local starting point . Food, shelter, showers, and more." },
];
---

<Base title="Base Impact. Find help, get connected.">
  <!-- Hero: type-only statement across two fields -->
  <section class="hero-fields">
    <div class="hero-lower">
      <div class="mx-auto max-w-6xl px-4">
        <h1 class="hero-headline">
          <span class="hero-line-upper">Help.</span>
        </h1>
        <p class="hero-subtitle">Base Impact · Find food, shelter, and essentials</p>
        <p class="hero-support">
          Base Impact connects people with food, shelter, showers, and essentials. It also helps small nonprofits keep their technology working.
        </p>
        <div class="hero-action">
          <a href="/directory" class="hero-btn">Find help near you</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Picture band after hero -->
  <div class="picture-band">
    <img src="/assets/food-pantry-volunteers.jpg" alt="Food pantry volunteers distributing groceries to neighbors" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <section class="stats-section">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        <div>
          <p class="stat-number">115</p>
          <p class="stat-label">Resources listed</p>
        </div>
        <div>
          <p class="stat-number">6</p>
          <p class="stat-label">Service types</p>
        </div>
        <div>
          <p class="stat-number">Any</p>
          <p class="stat-label">Languages</p>
        </div>
        <div>
          <p class="stat-number">24/7</p>
          <p class="stat-label">Help available</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Picture band after stats -->
  <div class="picture-band">
    <img src="/assets/homeless-shelter-community.jpg" alt="Community shelter providing a safe place for those in need" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <section class="capabilities-section">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="section-head">What we focus on</h2>
      <p class="section-intro">Immediate needs first. Then the skills and tools that keep people housed, employed, and connected.</p>
      <ul class="capability-list">
        {pillars.map((pillar) => (
          <li>
            <span class="capability-title">{pillar.title}</span>
            <span class="capability-body">{pillar.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Picture band after capabilities -->
  <div class="picture-band">
    <img src="/assets/tech-help-digital-skills.jpg" alt="Volunteer helping a neighbor learn digital skills on a laptop" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <section class="statement-section">
    <div class="mx-auto max-w-6xl px-4">
      <p class="statement-text">
        We believe everyone deserves a working device, a working connection, and someone to show them how.
      </p>
    </div>
  </section>
  <!-- Picture band after statement -->
  <div class="picture-band">
    <img src="/assets/community-food-support.jpg" alt="Community volunteers serving meals to neighbors in need" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <section class="emergency-section">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <a href="tel:211" class="emergency-card">
          <span class="emergency-label">24/7 local help</span>
          <span class="emergency-number">Call 211</span>
        </a>
        <a href="tel:+13213230999" class="emergency-card">
          <span class="emergency-label">Base Impact · by appointment</span>
          <span class="emergency-number">(321) 323-0999</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA: one word is the button -->
  <section class="cta-section">
    <div class="mx-auto max-w-6xl px-4">
      <p class="cta-word">Donate</p>
      <p class="cta-support">Help us keep connecting people with the resources they need.</p>
      <a href="/donate" class="cta-btn">Give now</a>
    </div>
  </section>
</Base>

<style>
  /* Picture band: full-width image */
  .picture-band {
    width: 100%;
    overflow: hidden;
    max-height: 50vh;
  }
  .picture-band img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Hero support text in upper field */
  .hero-support-upper {
    font-size: var(--step-body);
    color: var(--color-muted);
    max-width: 60ch;
    line-height: 1.5;
    padding: 2rem 0;
  }
  .hero-fields {
    padding: 4rem 0 6rem;
  }
  .hero-lower {
    background: var(--color-page);
  }
  .hero-headline {
    font-size: var(--step-display);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.86;
    margin: 0;
  }
  .hero-line-upper {
    display: block;
    color: var(--color-body);
  }
  .hero-line-lower {
    display: block;
    color: var(--color-muted);
  }
  .hero-support {
    font-size: var(--step-body);
    color: var(--color-muted);
    max-width: 40ch;
    margin-top: 2rem;
    line-height: 1.5;
  }
  .hero-subtitle {
    font-size: var(--step-lead);
    color: var(--color-body);
    margin-top: 1rem;
    line-height: 1.3;
  }
  .hero-action {
    margin-top: 2rem;
  }
  .hero-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-fill);
    color: var(--color-on-fill);
    font-weight: 600;
    font-size: var(--step-body);
    text-decoration: none;
  }
  .hero-btn:hover {
    background: var(--color-fill-hover);
  }

  /* Stats section */
  .stats-section {
    padding: 4rem 0;
    background: var(--color-card);
  }
  .stat-number {
    font-size: var(--step-head);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--color-body);
    margin: 0;
  }
  .stat-label {
    font-size: var(--step-body);
    font-weight: 500;
    color: var(--color-body);
    margin-top: 0.5rem;
  }
  .stat-receipt {
    font-size: var(--step-small);
    color: var(--color-body);
    margin-top: 2rem;
    max-width: 50ch;
    padding-right: 1rem;
  }

  /* Capabilities section */
  .capabilities-section {
    padding: 4rem 0;
  }
  .section-head {
    font-size: var(--step-head);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--color-body);
    margin: 0 0 1rem;
  }
  .section-intro {
    font-size: var(--step-body);
    color: var(--color-body);
    max-width: 30ch;
    margin: 0 0 2rem;
    padding-right: 2rem;
  }
  .capability-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .capability-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 2rem 1rem;
  }
  .capability-title {
    font-size: var(--step-lead);
    font-weight: 600;
    color: var(--color-body);
    max-width: 40ch;
    padding-right: 1.5rem;
  }
  .capability-body {
    font-size: var(--step-body);
    color: var(--color-body);
    max-width: 60ch;
  }

  /* Statement section: full-width colour field */
  .statement-section {
    padding: 6rem 0;
    background: var(--color-card);
  }
  .statement-text {
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-body);
    max-width: 50ch;
    padding-right: 1rem;
  }
  .emergency-section {
    padding: 4rem 0;
    background: var(--color-card);
  }
  .emergency-card {
    display: block;
    padding: 2rem;
    background: var(--color-page);
    text-decoration: none;
  }
  .emergency-card:hover {
    background: var(--color-inset);
  }
  .emergency-label {
    display: block;
    font-size: var(--step-small);
    color: var(--color-body);
    margin-bottom: 0.5rem;
  }
  .emergency-number {
    display: block;
    font-size: var(--step-lead);
    font-weight: 600;
    color: var(--color-body);
  }

  /* CTA section */
  .cta-section {
    padding: 6rem 0;
    text-align: center;
  }
  .cta-word {
    font-size: var(--step-display);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.86;
    color: var(--color-body);
    margin: 0;
  }
  .cta-support {
    font-size: var(--step-body);
    color: var(--color-body);
    margin: 1.5rem 0 2rem;
    max-width: 50ch;
  }
  .cta-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-fill);
    color: var(--color-on-fill);
    font-weight: 600;
    font-size: var(--step-body);
    text-decoration: none;
  }
  .cta-btn:hover {
    background: var(--color-fill-hover);
  }
  /* Motion layer */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-headline, .hero-subtitle, .hero-support, .hero-action {
    animation: fadeInUp 0.8s ease-out both;
  }
  .hero-subtitle { animation-delay: 0.1s; }
  .hero-support { animation-delay: 0.2s; }
  .hero-action { animation-delay: 0.3s; }

  .stats-section .stat-card {
    animation: fadeInUp 0.8s ease-out both;
  }
  .stats-section .stat-card:nth-child(1) { animation-delay: 0.1s; }
  .stats-section .stat-card:nth-child(2) { animation-delay: 0.2s; }
  .stats-section .stat-card:nth-child(3) { animation-delay: 0.3s; }
  .stats-section .stat-card:nth-child(4) { animation-delay: 0.4s; }

  .picture-band {
    animation: fadeInUp 1s ease-out both;
  }

  .capabilities-section .capability-list li {
    animation: fadeInUp 0.8s ease-out both;
  }
  .capabilities-section .capability-list li:nth-child(1) { animation-delay: 0.1s; }
  .capabilities-section .capability-list li:nth-child(2) { animation-delay: 0.2s; }
  .capabilities-section .capability-list li:nth-child(3) { animation-delay: 0.3s; }
  .capabilities-section .capability-list li:nth-child(4) { animation-delay: 0.4s; }

  .statement-section {
    animation: fadeInUp 0.8s ease-out both;
  }

  .emergency-section .emergency-card {
    animation: fadeInUp 0.8s ease-out both;
  }
  .emergency-section .emergency-card:nth-child(1) { animation-delay: 0.1s; }
  .emergency-section .emergency-card:nth-child(2) { animation-delay: 0.2s; }
  .emergency-section .emergency-card:nth-child(3) { animation-delay: 0.3s; }
  .emergency-section .emergency-card:nth-child(4) { animation-delay: 0.4s; }

  .cta-section {
    animation: fadeInUp 0.8s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-headline, .hero-subtitle, .hero-support, .hero-action,
    .stats-section .stat-card, .picture-band,
    .capabilities-section .capability-list li,
    .statement-section, .emergency-section .emergency-card,
    .cta-section {
      animation: none;
    }
  }
</style>
</Base>
