---
import Layout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Base Impact — Find Help',
  description: 'Find food, shelter, health, housing, and recovery resources in Brevard, Volusia, Orange & Statewide Counties. Technology help for Brevard County.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero -->
  <Hero
    tagline="Scottsmoor · Titusville · Brevard County"
    title="Technology help for Brevard County — devices, internet, and the skills to use them."
    subtitle="Base Impact helps neighbors get connected and helps small local nonprofits keep their technology working. Plus a local resource guide that works alongside 211."
    actions={[
      {
        variant: 'primary',
        text: 'Find help near me',
        href: '/directory',
        icon: 'tabler:search',
      },
      {
        variant: 'secondary',
        text: 'Need help?',
        href: '/technology-access',
        icon: 'tabler:help',
      },
    ]}
  />

  <!-- Quick Actions -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-6 mb-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href="tel:211" class="flex items-center justify-between rounded-2xl bg-white dark:bg-slate-800 p-4 shadow-lg border border-gray-100 dark:border-slate-700 hover:shadow-xl transition-shadow">
        <div>
          <span class="block text-xs font-bold uppercase tracking-wide text-blue-600 dark:text-blue-400">24/7 local help</span>
          <span class="font-heading text-xl font-semibold text-gray-900 dark:text-white">Call 211</span>
        </div>
        <Icon name="tabler:phone" class="w-8 h-8 text-blue-600 dark:text-blue-400" />
      </a>
      <a href="tel:+13213230999" class="flex items-center justify-between rounded-2xl bg-white dark:bg-slate-800 p-4 shadow-lg border border-gray-100 dark:border-slate-700 hover:shadow-xl transition-shadow">
        <div>
          <span class="block text-xs font-bold uppercase tracking-wide text-blue-600 dark:text-blue-400">Base Impact · by appointment</span>
          <span class="font-heading text-xl font-semibold text-gray-900 dark:text-white">(321) 323-0999</span>
        </div>
        <Icon name="tabler:phone" class="w-8 h-8 text-blue-600 dark:text-blue-400" />
      </a>
    </div>
  </section>

  <!-- Stats -->
  <Stats
    tagline="Impact"
    title="Serving our community"
    stats={[
      { amount: 83, title: 'Resources listed', description: 'Local services in our directory' },
      { amount: 6, title: 'Service types', description: 'Food, shelter, health, money, basics, crisis' },
      { amount: '24/7', title: 'Help available', description: 'Call 211 anytime' },
    ]}
  />

  <!-- What We Focus On -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="max-w-3xl">
      <h2 class="font-heading text-3xl font-semibold text-gray-900 dark:text-white">What we focus on</h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-slate-300">
        Immediate needs first. Then the skills and tools that keep people housed, employed, and connected.
      </p>
    </div>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <article class="rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700">
        <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Technology access</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-slate-300 leading-relaxed">Helping neighbors get a working device and internet service — and learn to use them.</p>
      </article>
      <article class="rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700">
        <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Digital skills & job help</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-slate-300 leading-relaxed">Walk-throughs for housing portals, job applications, benefits, and staying safe online.</p>
      </article>
      <article class="rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700">
        <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Tech for small nonprofits</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-slate-300 leading-relaxed">Free setup, security, and support for churches, pantries, and 1–5 person community groups.</p>
      </article>
      <article class="rounded-2xl bg-white dark:bg-slate-800 p-5 shadow-md border border-gray-100 dark:border-slate-700">
        <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Local resource guide</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-slate-300 leading-relaxed">A simpler, local starting point that works alongside 211 — food, shelter, showers, and more.</p>
      </article>
    </div>
  </section>

  <!-- Support CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="rounded-3xl bg-blue-600 dark:bg-blue-700 px-6 py-10 sm:px-10 sm:py-12 text-white">
      <h2 class="font-heading text-2xl sm:text-3xl font-semibold">Support our mission</h2>
      <p class="mt-3 max-w-2xl text-blue-100">
        Base Impact is a pre-filing nonprofit. Your support helps us provide devices, internet, training, and tech support to neighbors and small nonprofits in Brevard County.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="/donate" class="flex w-full items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-base font-semibold text-blue-700 hover:bg-blue-50 sm:w-auto">
          Donate
        </a>
        <a href="/volunteer" class="flex w-full items-center justify-center gap-2 rounded-full bg-blue-500 px-6 py-3 text-base font-semibold text-white hover:bg-blue-400 sm:w-auto">
          Volunteer
        </a>
      </div>
    </div>
  </section>
</Layout>
