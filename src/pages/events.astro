---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events', ({ data }) => !data.draft))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const now = new Date();
const upcoming = events.filter(e => e.data.date >= now || e.data.recurring);
const past = events.filter(e => e.data.date < now && !e.data.recurring);

const year = now.getFullYear();
const month = now.getMonth();
const monthName = now.toLocaleString('en-US', { month: 'long' });
const firstDay = new Date(year, month, 1).getDay();
const daysInMonth = new Date(year, month + 1, 0).getDate();
const recurring: Record<number, string> = {
  1: 'Under the Bridge Ministries (5-7pm)',
  4: 'Lifepointe Ministries — Showers, Clothes, Dinner (4:30-7pm)',
  6: 'FUMC Breakfast (8-9:30am)',
};
const cells: (number | null)[] = [];
for (let i = 0; i < firstDay; i++) cells.push(null);
for (let d = 1; d <= daysInMonth; d++) cells.push(d);
function dayLabel(d: number): string | null {
  const dow = new Date(year, month, d).getDay();
  return recurring[dow] ?? null;
}

const signedup = Astro.url.searchParams.get('signedup') === '1';

const categoryLabels: Record<string, string> = {
  volunteer: 'Volunteer',
  community: 'Community',
  fundraiser: 'Fundraiser',
  training: 'Training',
  other: 'Event',
};
const categoryColors: Record<string, string> = {
  volunteer: 'bg-fill',
  community: 'bg-fill',
  fundraiser: 'bg-fill-caution',
  training: 'bg-inset text-body',
  other: 'bg-inset text-body',
};
---

<Base title="Events — Base Impact" description="Upcoming events, cold-weather supply drives, shelter nights, and community impact stories from Base Impact.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Events &amp; Community Impact</h1>
  {signedup && (
    <div class="mb-6 rounded-xl bg-green-50 border border-green-200 px-4 py-3 text-green-800 font-semibold fade-in" role="status">
      Thanks! Your volunteer signup was received. We'll confirm by phone or email.
    </div>
  )}
  <p class="max-w-2xl text-muted leading-relaxed mb-8 fade-in">
    Cold weather is coming to Florida, and neighbors will need heavier clothing, blankets, and supplies
    for extended stays at cold-night shelter facilities. Here's what's coming up, what's needed, and
    what we've done together.
  </p>

  <!-- Upcoming events -->
  <section class="mb-10 space-y-4 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body">Upcoming</h2>
    {upcoming.length === 0 && <p class="text-muted">No upcoming events scheduled. Check back soon.</p>}
    <div class="space-y-4">
      {upcoming.map(event => (
        <article class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class={`rounded-md px-2 py-1 text-xs font-bold uppercase tracking-wide text-on-fill ${categoryColors[event.data.category] || 'bg-fill'}`}>
              {categoryLabels[event.data.category] || 'Event'}
            </span>
            <span class="text-sm font-semibold text-muted">
              {event.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              {event.data.location && ` · ${event.data.location}`}
              {event.data.city && event.data.state && ` · ${event.data.city}, ${event.data.state}`}
            </span>
          </div>
          <h3 class="font-display text-xl font-semibold text-body">{event.data.title}</h3>
          <p class="text-muted leading-relaxed">{event.data.description}</p>
          {event.data.registrationUrl && (
            <a href={event.data.registrationUrl} class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">
              Register
            </a>
          )}
        </article>
      ))}
      <article class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-md bg-fill px-2 py-1 text-xs font-bold uppercase tracking-wide text-on-fill">Cold weather</span>
          <span class="text-sm font-semibold text-muted">Coming soon · Brevard County</span>
        </div>
        <h3 class="font-display text-xl font-semibold text-body">Cold-night shelter supply drive</h3>
        <p class="text-muted leading-relaxed">
          Collecting heavier jackets, hoodies, blankets, socks, gloves, and hygiene kits for extended stays
          at cold-night shelter facilities. Drop-off and distribution details to be announced.
        </p>
        <p class="text-sm text-faint"><strong>Needed:</strong> 2XL+ jackets/hoodies, blankets, warm socks, gloves, toiletry kits</p>
      </article>
      <article class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-md bg-fill px-2 py-1 text-xs font-bold uppercase tracking-wide text-on-fill">Ongoing</span>
          <span class="text-sm font-semibold text-muted">By appointment · Scottsmoor, FL</span>
        </div>
        <h3 class="font-display text-xl font-semibold text-body">Device &amp; supply distribution</h3>
        <p class="text-muted leading-relaxed">
          Refurbished phones, tablets, and laptops distributed alongside warm clothing and supply kits.
          Call or text to schedule a pickup or drop-off.
        </p>
        <a href="tel:+13213230999" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">
          Call (321) 323-0999
        </a>
      </article>
    </div>
  </section>

  <!-- Calendar -->
  <section class="mb-10 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body mb-1">Event calendar</h2>
    <p class="text-sm text-muted mb-6">November {year}. Tentative dates; will be confirmed as events are scheduled.</p>

    <div id="calendar" class="rounded-2xl bg-card shadow-[var(--shadow-border)] p-2 sm:p-4"></div>

    <!-- Weekly schedule -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="https://m.facebook.com/pages/Under-the-Bridge-Ministries/764143213725825" target="_blank" rel="noopener" class="rounded-xl bg-card p-4 shadow-[var(--shadow-border)] group hover:shadow-lg transition-shadow">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-fill flex-shrink-0"></span>
          <p class="text-sm font-semibold text-body group-hover:text-accent">Under the Bridge Ministries</p>
        </div>
        <p class="text-xs text-muted ml-5">Every Monday · 5-7pm</p>
      </a>
      <a href="https://titusvilleciviccenter.com/lifepointe-ministries" target="_blank" rel="noopener" class="rounded-xl bg-card p-4 shadow-[var(--shadow-border)] group hover:shadow-lg transition-shadow">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-fill flex-shrink-0"></span>
          <p class="text-sm font-semibold text-body group-hover:text-accent">Lifepointe Ministries</p>
        </div>
        <p class="text-xs text-muted ml-5">Every Thursday · 4:30-7pm</p>
        <p class="text-xs text-muted ml-5">Showers, Clothes, Dinner</p>
      </a>
      <a href="https://fumctitusville.com/" target="_blank" rel="noopener" class="rounded-xl bg-card p-4 shadow-[var(--shadow-border)] group hover:shadow-lg transition-shadow">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-fill flex-shrink-0"></span>
          <p class="text-sm font-semibold text-body group-hover:text-accent">FUMC Breakfast</p>
        </div>
        <p class="text-xs text-muted ml-5">Every Saturday · 8-9:30am</p>
      </a>
    </div>
    <p class="text-xs text-muted italic mt-4">Dates are tentative and will be confirmed as events are scheduled.</p>
  </section>

  <!-- Recent impact -->
  <section class="mb-10 space-y-4 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body">Recent impact</h2>
    <div class="space-y-4">
      <article class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] space-y-2">
        <p class="text-xs font-bold uppercase tracking-widest text-muted">Community donation</p>
        <h3 class="font-display text-xl font-semibold text-body">Two 2XL jackets &amp; hoodies for a Scottsmoor neighbor</h3>
        <p class="text-muted leading-relaxed">
          A generous donor contributed two 2XL jackets and hoodies that went directly to a community member
          in Scottsmoor, FL. Small, targeted gifts like this make an immediate difference when cold weather hits.
        </p>
      </article>
      <article class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] space-y-2">
        <p class="text-xs font-bold uppercase tracking-widest text-muted">Housing stability</p>
        <h3 class="font-display text-xl font-semibold text-body">Matched an 80-something neighbor with a roommate</h3>
        <p class="text-muted leading-relaxed">
          We matched a lady in her mid-80s who had been living in her car with a roommate who welcomed her
          into her condo. We helped her move and rearrange so both could enjoy better, safer living conditions
          and keep each other company.
        </p>
      </article>
    </div>
  </section>

  <!-- Volunteer signup -->
  <section class="mb-10 fade-in">
    <h2 class="font-display text-2xl font-semibold text-body mb-3">Sign up to volunteer</h2>
    <p class="text-muted mb-4 max-w-2xl">Pick a shift and we'll confirm by phone or email. All are welcome — no experience needed.</p>
    <form class="max-w-lg space-y-4" method="POST" action="/api/volunteer-signup">
      <div>
        <label for="vname" class="block text-sm font-semibold text-body mb-1">Name</label>
        <input type="text" id="vname" name="name" required class="w-full rounded-lg border border-line bg-card px-3 py-3 text-body min-h-11" />
      </div>
      <div>
        <label for="vcontact" class="block text-sm font-semibold text-body mb-1">Phone or email</label>
        <input type="text" id="vcontact" name="contact" required class="w-full rounded-lg border border-line bg-card px-3 py-3 text-body min-h-11" />
      </div>
      <div>
        <label for="vshift" class="block text-sm font-semibold text-body mb-1">Which shift?</label>
        <select id="vshift" name="shift" required class="w-full rounded-lg border border-line bg-card px-3 py-3 text-body min-h-11">
          <option value="">Choose one…</option>
          <option value="monday-bridge">Monday — Under the Bridge Ministries (5-7pm)</option>
          <option value="thursday-lifepointe">Thursday — Lifepointe Ministries (4:30-7pm)</option>
          <option value="saturday-fumc">Saturday — FUMC Breakfast (8-9:30am)</option>
          <option value="any">Any / flexible</option>
        </select>
      </div>
      <div>
        <label for="vnotes" class="block text-sm font-semibold text-body mb-1">Notes (optional)</label>
        <textarea id="vnotes" name="notes" rows="3" class="w-full rounded-lg border border-line bg-card px-3 py-3 text-body" placeholder="Skills, availability, questions…"></textarea>
      </div>
      <button type="submit" class="rounded-xl bg-fill px-6 py-3 text-base font-semibold text-on-fill hover:bg-fill-hover min-h-11">Sign up</button>
    </form>
  </section>

  <section class="rounded-2xl bg-band p-6 text-on-fill fade-in">
    <h2 class="font-display text-xl font-semibold mb-2">Help with cold-weather supplies</h2>
    <p class="text-sm opacity-90 mb-4">
      Have heavier clothing, blankets, or supplies to donate? Want to volunteer at a shelter night or
      distribution day? We'd love your help — every item and every hour counts.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/donate" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Donate supplies</a>
      <a href="/volunteer" class="inline-flex min-h-11 items-center rounded-lg border border-line bg-card/20 px-5 py-2 text-sm font-semibold text-on-fill hover:bg-card/40">Volunteer</a>
      <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg border border-line bg-card/20 px-5 py-2 text-sm font-semibold text-on-fill hover:bg-card/40">Get in touch</a>
    </div>
  </section>

<script is:inline>
  // FullCalendar will be loaded from CDN
</script>
<style>
  /* FullCalendar theme overrides for Base Impact */
  .fc { --fc-border-color: var(--color-line, #2a5a3a); --fc-today-bg-color: rgba(19,54,33,0.15); }
  .fc .fc-toolbar-title { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; color: var(--color-body); }
  .fc .fc-button { background: var(--color-fill, #133621); border-color: var(--color-fill, #133621); color: var(--color-on-fill, #f6e58a); font-weight: 600; }
  .fc .fc-button:hover { background: var(--color-fill-hover, #1a4429); border-color: var(--color-fill-hover, #1a4429); }
  .fc .fc-button-primary:not(:disabled).fc-button-active { background: var(--color-fill-hover, #1a4429); }
  .fc .fc-daygrid-day-number { color: var(--color-body); }
  .fc .fc-col-header-cell-cushion { color: var(--color-muted); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; }
  .fc .fc-day-today .fc-daygrid-day-number { background: var(--color-fill, #133621); color: var(--color-on-fill, #f6e58a); border-radius: 50%; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; }
  .fc .fc-event { border-radius: 4px; font-size: 0.75rem; padding: 1px 4px; }
  .fc-theme-standard td, .fc-theme-standard th { border-color: var(--color-line, #2a5a3a); }
  .fc-theme-standard .fc-scrollgrid { border-color: var(--color-line, #2a5a3a); }
  .fc .fc-daygrid-day { background: var(--color-card, #1a4429); }
  .fc .fc-daygrid-day.fc-day-other { background: var(--color-page, #133621); opacity: 0.5; }
</style>
<style>
  .fc { --fc-border-color: var(--color-line, #2a5a3a); --fc-today-bg-color: rgba(19,54,33,0.15); }
  .fc .fc-toolbar-title { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; color: var(--color-body); }
  .fc .fc-button { background: var(--color-fill, #133621); border-color: var(--color-fill, #133621); color: var(--color-on-fill, #f6e58a); font-weight: 600; }
  .fc .fc-button:hover { background: var(--color-fill-hover, #1a4429); border-color: var(--color-fill-hover, #1a4429); }
  .fc .fc-button-primary:not(:disabled).fc-button-active { background: var(--color-fill-hover, #1a4429); }
  .fc .fc-daygrid-day-number { color: var(--color-body); }
  .fc .fc-col-header-cell-cushion { color: var(--color-muted); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; }
  .fc .fc-day-today .fc-daygrid-day-number { background: var(--color-fill, #133621); color: var(--color-on-fill, #f6e58a); border-radius: 50%; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; }
  .fc .fc-event { border-radius: 4px; font-size: 0.75rem; padding: 1px 4px; }
  .fc-theme-standard td, .fc-theme-standard th { border-color: var(--color-line, #2a5a3a); }
  .fc-theme-standard .fc-scrollgrid { border-color: var(--color-line, #2a5a3a); }
  .fc .fc-daygrid-day { background: var(--color-card, #1a4429); }
  .fc .fc-daygrid-day.fc-day-other { background: var(--color-page, #133621); opacity: 0.5; }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    if (!calendarEl || typeof FullCalendar === 'undefined') return;
    var calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      initialDate: new Date().toISOString().slice(0, 10).slice(0, 7) + '-01',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: ''
      },
      height: 'auto',
      events: [
        { title: 'Under the Bridge Ministries', daysOfWeek: [1], startTime: '17:00', endTime: '19:00', color: '#133621' },
        { title: 'Lifepointe — Showers & Dinner', daysOfWeek: [4], startTime: '16:30', endTime: '19:00', color: '#133621' },
        { title: 'FUMC Breakfast', daysOfWeek: [6], startTime: '08:00', endTime: '09:30', color: '#133621' }
      ],
      eventDisplay: 'block',
      dayMaxEvents: 3
    });
    calendar.render();
  });
</script>

</Base>
