---
import Base from '../layouts/Base.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
---

<Base>
  <div class="picture-band">
    <img src="/assets/tech-support-session.jpg" alt="Technology support session helping a neighbor" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Contact Us</h1>

  {Astro.url.searchParams.get('sent') === '1' && (
    <div class="rounded-xl border border-accent/40 bg-card p-4 mb-6 max-w-lg text-body">
      Thanks — your message was sent. We reply within a few business days.
    </div>
  )}

  <div class="grid gap-4 sm:grid-cols-2 max-w-2xl mb-8">
    <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
      <p class="text-xs font-bold uppercase tracking-widest text-faint mb-1">Phone</p>
      <a href="tel:+132****0999" class="text-accent font-semibold">(321) 323-0999</a>
      <p class="text-sm text-muted mt-1">Call or text · by appointment only</p>
    </div>
    <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
      <p class="text-xs font-bold uppercase tracking-widest text-faint mb-1">Email</p>
      <a href="mailto:admin@baseimpact.org" class="text-accent font-semibold break-all">admin@baseimpact.org</a>
      <p class="text-sm text-muted mt-1">We reply within a few business days</p>
    </div>
    <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
      <p class="text-xs font-bold uppercase tracking-widest text-faint mb-1">Location</p>
      <p class="text-body font-semibold">Scottsmoor, FL 32775</p>
      <p class="text-sm text-muted mt-1">Brevard County · visits by appointment</p>
    </div>
    <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
      <p class="text-xs font-bold uppercase tracking-widest text-faint mb-1">Need help now?</p>
      <a href="tel:211" class="text-accent font-semibold">Call 211</a>
      <p class="text-sm text-muted mt-1">24/7 crisis &amp; referral line for Florida</p>
    </div>
  </div>

  <form class="max-w-lg space-y-4" method="POST" action="/api/contact">
    <div>
      <label for="name" class="block text-sm font-semibold text-body mb-1">Name</label>
      <input type="text" id="name" name="name" required
        class="w-full rounded-lg border border-line bg-card px-3 py-2 text-body" />
    </div>
    <div>
      <label for="email" class="block text-sm font-semibold text-body mb-1">Email</label>
      <input type="email" id="email" name="email" required
        class="w-full rounded-lg border border-line bg-card px-3 py-2 text-body" />
    </div>
    <div>
      <label for="message" class="block text-sm font-semibold text-body mb-1">Message</label>
      <textarea id="message" name="message" rows="4" required
        class="w-full rounded-lg border border-line bg-card px-3 py-2 text-body"></textarea>
    </div>
    <TurnstileWidget />
    <button type="submit" class="rounded-xl bg-fill px-6 py-3 text-base font-semibold text-on-fill hover:bg-fill-hover">
      Send message
    </button>
  </form>
</Base>