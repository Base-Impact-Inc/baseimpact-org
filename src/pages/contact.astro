---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Contact Us — Base Impact', description: 'Get in touch with Base Impact.', ignoreTitleTemplate: true }}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="max-w-2xl">
      <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white">Contact Us</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">Get in touch with Base Impact. We're here to help.</p>

      <div class="mt-8 space-y-6">
        <div class="rounded-2xl bg-white dark:bg-slate-800 p-6 shadow-md border border-gray-100 dark:border-slate-700">
          <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Email</h3>
          <a href="mailto:info@baseimpact.org" class="text-blue-600 dark:text-blue-400 hover:underline">info@baseimpact.org</a>
        </div>
        <div class="rounded-2xl bg-white dark:bg-slate-800 p-6 shadow-md border border-gray-100 dark:border-slate-700">
          <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Phone</h3>
          <a href="tel:211" class="text-blue-600 dark:text-blue-400 hover:underline">211 — 24/7 local help</a>
        </div>
        <div class="rounded-2xl bg-white dark:bg-slate-800 p-6 shadow-md border border-gray-100 dark:border-slate-700">
          <h3 class="font-heading text-lg font-semibold text-gray-900 dark:text-white">Base Impact Office</h3>
          <p class="text-gray-600 dark:text-slate-300">Scottsmoor, Brevard County, FL</p>
          <p class="text-gray-600 dark:text-slate-300">By appointment</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
