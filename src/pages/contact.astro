---
import Base from '@/layouts/Base.astro';

const metadata = {
  title: 'Contact — Base Impact',
  description: 'Contact Base Impact for partnerships, volunteer inquiries, event hosting, or general questions.',
};
---

<Base title={metadata.title} description={metadata.description}>
  <section class="section">
    <div class="container max-w-3xl">
      <h1 class="text-4xl font-bold text-text-dark dark:text-darkmode-text-light mb-6">Contact</h1>
      <div class="prose dark:prose-invert space-y-6 text-text dark:text-darkmode-text">
        <p>
          Use the form below or email us directly. We read every message and typically respond within
          3 business days.
        </p>

        <form class="space-y-4" action="#" method="POST">
          <div>
            <label class="block text-sm font-semibold mb-1">Full Name</label>
            <input type="text" name="name" required class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">Email</label>
            <input type="email" name="email" required class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">Subject</label>
            <select name="subject" class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2">
              <option value="general">General Question</option>
              <option value="partnership">Partnership</option>
              <option value="volunteer">Volunteer Inquiry</option>
              <option value="event">Event Hosting</option>
              <option value="resource">Resource Listing</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">Message</label>
            <textarea name="message" rows="6" required class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
      </div>
    </div>
  </section>
</Base>
