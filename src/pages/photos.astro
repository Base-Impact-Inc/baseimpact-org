---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos', ({ data }) => !data.draft && data.consent))
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));

const albums = [...new Set(photos.map(p => p.data.album))];
---

<Base title="Photo Album — Base Impact" description="Photos from community events, volunteer activities, and impact stories.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Photo Album</h1>
  <p class="text-muted leading-relaxed mb-8 fade-in max-w-2xl">
    Moments from community events, volunteer activities, and impact stories. All photos shared with consent.
  </p>

  {albums.map(album => {
    const albumPhotos = photos.filter(p => p.data.album === album);
    return (
      <section class="mb-10 fade-in">
        <h2 class="font-display text-xl font-semibold text-body mb-4 capitalize">{album.replace(/-/g, ' ')}</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {albumPhotos.map(photo => (
            <figure class="rounded-2xl bg-card overflow-hidden shadow-[var(--shadow-border)]">
              <img src={photo.data.image} alt={photo.data.title} class="w-full h-48 object-cover" loading="lazy" />
              <figcaption class="p-4">
                <h3 class="font-display text-base font-semibold text-body">{photo.data.title}</h3>
                {photo.data.caption && <p class="text-sm text-muted mt-1">{photo.data.caption}</p>}
                <p class="text-xs text-faint mt-2">
                  {photo.data.date?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {photo.data.city && photo.data.state && ` · ${photo.data.city}, ${photo.data.state}`}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    );
  })}

  {photos.length === 0 && (
    <p class="text-muted">No photos yet. Check back soon.</p>
  )}
</Base>
