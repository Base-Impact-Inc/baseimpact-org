---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="py-16 sm:py-24 bg-page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-electric-blue">Search Results</p>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-body mb-4">
          Search for <span class="text-electric-blue" id="search-term"></span>
        </h1>
        <p class="text-lg text-muted max-w-xl mx-auto mb-8" id="search-meta"></p>
      </div>
    </div>
  </section>

  <section id="search-results" class="py-12 sm:py-16 bg-inset">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p id="results-count" class="text-sm text-muted mb-4"></p>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl" id="resource-grid">
      </div>
      <div id="pagination" class="mt-4 flex justify-center">
        <button type="button" id="load-more" class="rounded-lg px-4 py-2 text-sm font-semibold bg-inset text-body hover:bg-line disabled:opacity-50 transition-opacity" disabled>
          Load more
        </button>
      </div>
      <div id="empty-state" class="hidden text-center py-12">
        <p class="text-lg text-muted">No resources found.</p>
        <p class="text-sm text-faint mt-2">Try a different search or filter.</p>
        <a href="/directory" class="inline-flex items-center gap-2 mt-4 text-electric-blue hover:underline">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          Back to full directory
        </a>
      </div>
    </div>
  </section>

  <div class="py-8 bg-fill-caution text-on-fill">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="text-lg font-semibold">Need immediate help?</span>
        <a href="tel:211" class="inline-flex items-center gap-2 rounded-xl bg-on-fill px-4 py-2 text-sm font-semibold hover:bg-on-fill/90 transition-colors">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call 211 — 24/7
        </a>
        <a href="tel:988" class="inline-flex items-center gap-2 rounded-xl bg-on-fill px-4 py-2 text-sm font-semibold hover:bg-on-fill/90 transition-colors">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>
          Crisis 988 — 24/7
        </a>
      </div>
    </div>
  </div>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const query = params.get('q') || '';
  const zip = params.get('zip') || '';
  const radius = params.get('radius') || '10';
  const category = params.get('category') || 'all';

  document.getElementById('search-term').textContent = query || 'all resources';
  document.getElementById('search-meta').textContent = 
    (query ? 'for "' + query + '" ' : '') + (zip ? 'near ' + zip + ' ' : '') + (radius !== '0' ? 'within ' + radius + ' miles' : 'any distance');

  window.location.href = '/directory?q=' + encodeURIComponent(query) + '&zip=' + encodeURIComponent(zip) + '&radius=' + encodeURIComponent(radius) + '&category=' + encodeURIComponent(category);
</script>
