---
import Base from '../layouts/Base.astro';

const organizations = [
  {
    name: 'LifePointe Ministries, Inc.',
    meta: 'EIN 45-1198607 · Titusville, FL · 501(c)(3)',
    body: 'Operates the Titusville Civic Center. Provides homeless showers, clothing, essentials, toiletries, and Thursday evening dinners. Operates the only inclement-weather cold-night shelter between Titusville and Port Orange. Runs CREW 29 outreach ministry providing meals, clothing, hygiene items, and fellowship. (Fiscal sponsorship pending.)',
  },
  {
    name: 'No One Hungry, Inc.',
    meta: 'EIN 83-2834992 · Titusville, FL · 501(c)(3)',
    body: 'Operates the Pine St Food Pantry providing food and basic necessities. Delivers food to homebound seniors. Reaches people experiencing homelessness with food and personal care items.',
  },
  {
    name: 'Hope for North Brevard, Inc.',
    meta: 'EIN 27-0352718 · Brevard County, FL · 501(c)(3)',
    body: 'Sponsors Under The Bridge Ministries. Provides community support and outreach in North Brevard County.',
  },
  {
    name: 'The Rock Church',
    meta: 'EIN 85-2661919 · Mims/Scottsmoor, FL · 501(c)(3)',
    body: 'Congregation serving Brevard County through worship, community events, and outreach to families in need. Planted with the Florida Baptist Convention.',
  },
  {
    name: 'Under The Bridge Ministries',
    meta: 'Titusville, FL · Sponsored by Hope for North Brevard',
    body: 'Faith-based outreach serving people experiencing homelessness. Meets Monday evenings under the A. Max Brewer Bridge to share hot meals, blankets, and supplies.',
  },
  {
    name: 'First United Methodist Church of Titusville',
    meta: 'Titusville, FL · Church (automatically tax-exempt)',
    body: 'Runs the Community Breakfast program providing food, essentials, clothing, and a safe space to shelter from the weather. Not a full-time shelter — partners with LifePointe Ministries for cold-night shelter overflow.',
  },
  {
    name: 'First Christian Church of Titusville',
    meta: 'Titusville, FL · Church (automatically tax-exempt)',
    body: 'Congregation serving North Brevard County through worship, fellowship, and practical outreach to families in need.',
  },
];

const partnershipOpportunities = [
  {
    title: 'Cell providers',
    body: 'Seeking AT&T, Verizon, T-Mobile, and others to provide free or low-cost phones and tablets with data plans — so recipients can reach job portals, housing applications, telehealth, and emergency services.',
  },
  {
    title: 'Technology companies',
    body: 'Seeking hardware and infrastructure: tablets and laptops for training, desktops and servers for local AI, parts for refurbishment, software and licenses, and AI-capable workstations.',
  },
  {
    title: 'Churches & nonprofits',
    body: 'Seeking local churches, ministries, and nonprofits for joint events, co-hosted digital-skills training, project collaboration, and shared space for community programs.',
  },
];

const techHelp = [
  { org: 'No One Hungry', detail: 'Trained on existing sign-in system for guest registration, applicant intake sheets, and database for tracking food pantry guests.' },
  { org: 'The Rock Church', detail: 'Audio/video system setup, livestreaming, sound board configuration, Wi-Fi, office computers, presentation software, and website.' },
  { org: 'First Christian Church', detail: 'Technology needs, computer and internet navigation assistance.' },
  { org: 'LifePointe Ministries', detail: 'Technology support for CREW 29 outreach operations.' },
];

const involvement = [
  'Food service and meal preparation',
  'Clothing distribution to families and individuals in need',
  'Cold-night shelter security and support during extreme weather',
  'Communications and safety team service',
  'Technology support and device setup for neighbors and nonprofits',
  'Senior assistance — transportation, technology, and daily needs',
  'Housing connections — helping people find stable housing',
  'Emergency response — acquiring and distributing cold weather supplies',
  'Community cleanup and beautification',
];
---

<Base title="Partners — Base Impact" description="Organizations and businesses partnering with Base Impact to bring technology help to Brevard County, FL.">
  <h1 class="font-display text-3xl font-semibold text-body mb-4 fade-in">Partners</h1>

  <p class="max-w-2xl text-muted leading-relaxed fade-in">Base Impact works alongside local organizations, churches, pantries, and small nonprofits to bring technology help where it's needed most.</p>

  <!-- How we partner -->
  <section class="mt-8 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-3">How we partner</h2>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <li class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Technology setup &amp; support</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Free device setup, security, and ongoing support for 1–5 person community groups.</p>
      </li>
      <li class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Resource sharing</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Our directory lists local services alongside 211, making it easier for neighbors to find help.</p>
      </li>
      <li class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Volunteer coordination</h3>
        <p class="mt-1 text-sm text-muted leading-snug">We connect skilled volunteers with organizations that need tech help.</p>
      </li>
    </ul>
  </section>

  <!-- Organizations where I volunteer -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Organizations where I volunteer</h2>
    <p class="max-w-2xl text-muted leading-relaxed mb-4">Base Impact's founder has volunteered and provided hands-on service at the following verified tax-exempt organizations in Brevard County. These are not formal partnerships — they are places where I have served and built relationships.</p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {organizations.map((org) => (
        <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
          <h3 class="font-display text-lg font-semibold text-body">{org.name}</h3>
          <p class="text-sm text-faint">{org.meta}</p>
          <p class="text-sm text-muted mt-2">{org.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Technology help provided -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-3">Technology help provided</h2>
    <p class="text-muted leading-relaxed mb-3">Base Impact has provided free technology services to these organizations:</p>
    <ul class="space-y-2">
      {techHelp.map((item) => (
        <li class="rounded-xl bg-card p-4 shadow-[var(--shadow-border)] text-muted">
          <strong class="text-body">{item.org}</strong> — {item.detail}
        </li>
      ))}
    </ul>
  </section>

  <!-- Community involvement -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-3">Community involvement</h2>
    <p class="max-w-2xl text-muted leading-relaxed mb-3">Base Impact's founder is deeply involved in the Brevard County community through hands-on volunteer work at local churches, food pantries, cold-night shelters, and community organizations. This direct experience shapes our programs and ensures we understand the real needs of the people we serve.</p>
    <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {involvement.map((item) => (
        <li class="flex items-start gap-2 text-muted">
          <svg class="mt-1 size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden><path d="M20 6L9 17l-5-5"/></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Membership & upcoming -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-3">Membership &amp; upcoming</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body">Brevard Homeless Coalition</h3>
        <p class="text-sm text-faint">Brevard County, FL · Continuum of Care (CoC)</p>
        <p class="text-sm text-muted mt-2">Base Impact Inc. is a new member of the <a href="https://brevardhomelesscoalition.org/coc/" class="text-accent underline" target="_blank" rel="noopener">Brevard Homeless Coalition</a>, the Continuum of Care (CoC) for Brevard County. The CoC coordinates housing and services for people experiencing homelessness, including the annual Point-in-Time count, housing programs, and community-wide planning to end homelessness.</p>
      </div>
      <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-lg font-semibold text-body">Feed Hope Now</h3>
        <p class="text-sm text-faint">Brevard County, FL · <a href="https://feedhopenow.org/get-involved/volunteer/" class="text-accent underline" target="_blank" rel="noopener">feedhopenow.org</a></p>
        <p class="text-sm text-muted mt-2">Base Impact's founder is in the process of becoming a volunteer with Feed Hope Now. Volunteer activities will include food distribution and community support.</p>
        <p class="text-sm text-faint mt-2">Status: Account setup in progress — volunteering not yet started.</p>
      </div>
    </div>
  </section>

  <!-- Partnership opportunities -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Partnership opportunities</h2>
    <p class="max-w-2xl text-muted leading-relaxed mb-4">We are actively seeking partners across three areas. If your company or organization would like to collaborate, please reach out.</p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {partnershipOpportunities.map((p) => (
        <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
          <h3 class="font-display text-base font-semibold text-body">{p.title}</h3>
          <p class="mt-1 text-sm text-muted leading-snug">{p.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-3 text-sm text-faint">Potential technology partners include Microsoft, Google, Apple, Dell, HP, Lenovo, and other companies with nonprofit donation programs.</p>
  </section>

  <!-- Become a partner -->
  <section class="mt-10 rounded-2xl bg-card p-8 shadow-[var(--shadow-border)] fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Become a partner</h2>
    <p class="text-muted leading-relaxed mb-4">If your organization serves Brevard County and could benefit from technology support, we'd love to hear from you.</p>
    <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">Contact us</a>
  </section>
</Base>
