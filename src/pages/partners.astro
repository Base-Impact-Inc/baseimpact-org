---
import Base from '../layouts/Base.astro';

const orgs = [
  {
    name: 'LifePointe Ministries, Inc.',
    meta: 'EIN 45-1198607 · Titusville, FL · 501(c)(3)',
    body: 'Operates the Titusville Civic Center. Provides homeless showers, clothing, essentials, toiletries, and Thursday evening dinners. Operates the only inclement-weather cold-night shelter between Titusville and Port Orange. Runs CREW 29 outreach ministry providing meals, clothing, hygiene items, and fellowship.',
  },
  {
    name: 'No One Hungry, Inc.',
    meta: 'EIN 83-2834992 · Titusville, FL · 501(c)(3)',
    body: 'Operates the Pine St Food Pantry providing food and basic necessities. Delivers food to homebound seniors. Reaches people experiencing homelessness with food and personal care items.',
  },
  {
    name: 'Hope for North Brevard, Inc.',
    meta: 'EIN 27-0352718 · Brevard County, FL · 501(c)(3)',
    body: 'Sponsors Under The Bridge Ministries. Provides community support and outreach in North Brevard County.',
  },
  {
    name: 'The Rock Church',
    meta: 'EIN 85-2661919 · Mims/Scottsmoor, FL · 501(c)(3)',
    body: 'Congregation serving Brevard County through worship, community events, and outreach to families in need. Planted with the Florida Baptist Convention.',
  },
  {
    name: 'Under The Bridge Ministries',
    meta: 'Titusville, FL · Sponsored by Hope for North Brevard',
    body: 'Faith-based outreach serving people experiencing homelessness. Meets Monday evenings under the A. Max Brewer Bridge to share hot meals, blankets, and supplies.',
  },
  {
    name: 'First United Methodist Church of Titusville',
    meta: 'Titusville, FL · Church (automatically tax-exempt)',
    body: 'Runs the Community Breakfast program providing food, essentials, clothing, and a safe space to shelter from the weather. Not a full-time shelter — partners with LifePointe Ministries for cold-night shelter overflow.',
  },
  {
    name: 'First Christian Church of Titusville',
    meta: 'Titusville, FL · Church (automatically tax-exempt)',
    body: 'Congregation serving North Brevard County through worship, fellowship, and practical outreach to families in need.',
  },
];

const techHelp = [
  { org: 'No One Hungry', detail: 'Trained on sign-in system, intake sheets, and food pantry guest database.' },
  { org: 'The Rock Church', detail: 'Audio/video system setup, livestreaming, Wi-Fi, office computers, presentation software.' },
  { org: 'LifePointe Ministries', detail: 'Technology support for CREW 29 outreach operations, tablets, and AV connections.' },
];

const involvement = [
  'Food service and meal preparation',
  'Clothing distribution to families and individuals in need',
  'Cold-night shelter security and support during extreme weather',
  'Communications and safety team service',
  'Technology support and device setup for neighbors and nonprofits',
  'Senior assistance — transportation, technology, and daily needs',
  'Housing connections — helping people find stable housing',
  'Emergency response — acquiring and distributing cold weather supplies',
  'Community cleanup and beautification',
];

const opportunities = [
  {
    title: 'Cell provider partnerships',
    body: 'We are seeking partnerships with cellular providers (AT&T, Verizon, T-Mobile, and others) to provide free or low-cost phones and tablets with data plans to homeless individuals and people in need — so recipients can reach job portals, housing applications, telehealth, and emergency services.',
  },
  {
    title: 'Technology company partnerships',
    body: 'We are seeking hardware and infrastructure from technology companies: tablets and laptops for digital skills training, desktops and servers for local AI and document processing, parts for device refurbishment, software and licenses, and AI-capable workstations.',
  },
  {
    title: 'Church & nonprofit partnerships',
    body: 'We are seeking local churches, ministries, and nonprofits for joint community events, co-hosted digital-skills training, program collaboration, and shared space for training sessions and community programs.',
  },
];
---

<Base
  title="Partners — Base Impact"
  description="Community involvement, volunteer relationships, and partnership opportunities for Base Impact Inc. — a Florida nonprofit corporation in Brevard County, FL."
>
  <div class="picture-band">
    <img src="/assets/community-volunteers.jpg" alt="Community volunteers working together" width="1920" height="1280" loading="lazy" decoding="async" />
  </div>
  <div class="max-w-2xl space-y-6 text-muted leading-relaxed fade-in">
    <h1 class="font-display text-3xl font-semibold text-body mb-4">Partners</h1>
    <p>
      Base Impact works alongside local organizations, churches, pantries, and small nonprofits
      to bring technology help where it's needed most. We are a Florida nonprofit corporation
      in Scottsmoor, FL. We have no formal partnerships yet — all relationships listed here are
      volunteer-based, built through hands-on service in the community.
    </p>
  </div>

  <!-- How we partner -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-4">How we partner</h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Technology setup &amp; support</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Free device setup, security, and ongoing support for 1–5 person community groups.</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Resource sharing</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Our directory lists local services, making it easier for neighbors to find help.</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Volunteer coordination</h3>
        <p class="mt-1 text-sm text-muted leading-snug">We connect skilled volunteers with organizations that need tech help.</p>
      </div>
    </div>
  </section>

  <!-- Track record -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Our track record</h2>
    <p class="max-w-2xl text-muted leading-relaxed mb-5">
      Base Impact's founder has volunteered at local churches, food pantries, cold-night shelters,
      and community organizations in Brevard County. That hands-on service shapes our programs and
      ensures we understand the real needs of the people we serve.
    </p>

    <h3 class="font-display text-lg font-semibold text-body mb-3">Technology help provided (as a volunteer)</h3>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {techHelp.map((item) => (
        <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
          <p class="text-sm font-semibold text-body">{item.org}</p>
          <p class="text-sm text-muted mt-1">{item.detail}</p>
        </div>
      ))}
    </div>

    <h3 class="font-display text-lg font-semibold text-body mt-8 mb-3">Organizations where I volunteer</h3>
    <p class="text-sm text-faint mb-4">These are not formal partnerships — they are places where our founder has served and built relationships.</p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {orgs.map((org) => (
        <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
          <h3 class="font-display text-lg font-semibold text-body">{org.name}</h3>
          <p class="text-sm text-faint mt-0.5">{org.meta}</p>
          <p class="text-sm text-muted mt-2">{org.body}</p>
        </div>
      ))}
    </div>

    <h3 class="font-display text-lg font-semibold text-body mt-8 mb-3">Community involvement</h3>
    <p class="max-w-2xl text-muted leading-relaxed mb-3">
      Hands-on volunteer work at local churches, food pantries, cold-night shelters, and community
      organizations — the direct experience that shapes every program we build.
    </p>
    <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {involvement.map((item) => (
        <li class="flex items-start gap-2 text-muted">
          <svg class="mt-1 size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden>
            <path d="M20 6L9 17l-5-5" />
          </svg>
          <span class="text-sm">{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Formal memberships & in-progress -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Memberships &amp; in-progress</h2>

    <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
      <h3 class="font-display text-lg font-semibold text-body">Brevard Homeless Coalition (CoC)</h3>
      <p class="text-sm text-faint mt-0.5">Brevard County, FL · Continuum of Care</p>
      <p class="text-sm text-muted mt-2">
        Base Impact is exploring membership with the <a href="https://brevardhomelesscoalition.org/coc/" class="text-accent underline" target="_blank" rel="noopener">Brevard Homeless Coalition</a>, the Continuum of Care (CoC) for Brevard County. The CoC coordinates housing and services for people experiencing homelessness, including the annual Point-in-Time count, housing programs, and community-wide planning to end homelessness. We hope to contribute technology access and digital skills training to those efforts.
      </p>
    </div>

    <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)] mt-4">
      <h3 class="font-display text-lg font-semibold text-body">Feed Hope Now</h3>
      <p class="text-sm text-faint mt-0.5">Brevard County, FL · <a href="https://feedhopenow.org/get-involved/volunteer/" class="text-accent underline" target="_blank" rel="noopener">feedhopenow.org</a></p>
      <p class="text-sm text-muted mt-2">
        Base Impact's founder is in the process of becoming a volunteer with Feed Hope Now.
        Account creation in progress. Volunteer activities will include food distribution and
        community support.
      </p>
      <p class="text-sm text-faint mt-2">Status: Account setup in progress — volunteering not yet started.</p>
    </div>
  </section>

  <!-- Partnership opportunities -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Partnership opportunities</h2>
    <p class="max-w-2xl text-muted leading-relaxed mb-5">
      We are actively seeking partners across three areas. If your company or organization
      serves Brevard County and would like to collaborate, we'd love to talk.
    </p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {opportunities.map((p) => (
        <div class="rounded-2xl bg-card p-6 shadow-[var(--shadow-border)]">
          <h3 class="font-display text-base font-semibold text-body">{p.title}</h3>
          <p class="mt-2 text-sm text-muted leading-snug">{p.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-3 text-sm text-faint">
      Potential technology partners include Microsoft, Google, Apple, Dell, HP, Lenovo, and other
      companies with nonprofit donation programs.
    </p>
  </section>

  <!-- Technology & AI vision -->
  <section class="mt-10 fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Technology &amp; AI vision</h2>
    <p class="max-w-2xl text-muted leading-relaxed mb-4">
      Base Impact is pursuing grants and partnerships to build technology infrastructure that
      serves the community privately, reliably, and without cloud dependency.
    </p>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">AI-capable hardware</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Laptops and workstations to run local AI models for form filling, document understanding, and tech troubleshooting — privately, on-device.</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Training devices</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Laptops and tablets for hands-on digital skills training. Devices may be loaned or donated to participants.</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Cell phone &amp; tablet partnerships</h3>
        <p class="mt-1 text-sm text-muted leading-snug">Free/low-cost phones and tablets with data plans so recipients can access job portals, housing, telehealth, and emergency services.</p>
      </div>
      <div class="rounded-2xl bg-card p-5 shadow-[var(--shadow-border)]">
        <h3 class="font-display text-base font-semibold text-body">Device refurbishment</h3>
        <p class="mt-1 text-sm text-muted leading-snug">A program to extend the life of donated technology — turning surplus devices into tools for sustainable living.</p>
      </div>
    </div>
  </section>

  <!-- Become a partner -->
  <section class="mt-10 rounded-2xl bg-card p-8 shadow-[var(--shadow-border)] fade-in">
    <h2 class="font-display text-xl font-semibold text-body mb-2">Become a partner</h2>
    <p class="text-muted leading-relaxed mb-4 max-w-2xl">
      If your organization serves Brevard County and could benefit from technology support, we'd love to hear from you.
      We are especially interested in speaking with cell providers, technology companies, and community organizations
      about grant-funded partnerships and program collaboration.
    </p>
    <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg bg-fill px-5 py-2 text-sm font-semibold text-on-fill hover:bg-fill-hover">
      Contact us
    </a>
  </section>
</Base>
