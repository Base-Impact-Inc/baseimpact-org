---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Base Impact`} description={post.data.description}>
  <article class="max-w-3xl mx-auto fade-in">
    {post.data.image && (
      <img src={post.data.image} alt={post.data.title} class="w-full h-72 object-cover rounded-2xl mb-8" loading="lazy" />
    )}
    <div class="mb-6">
      <h1 class="font-display text-4xl font-semibold text-body mb-3 leading-tight">{post.data.title}</h1>
      {post.data.description && (
        <p class="text-lg text-muted leading-relaxed">{post.data.description}</p>
      )}
      <p class="text-sm text-faint mt-4">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.categories.length > 0 && (
          <span> · {post.data.categories.join(', ')}</span>
        )}
        {post.data.tags.length > 0 && (
          <span> · {post.data.tags.join(', ')}</span>
        )}
      </p>
    </div>
    <div class="prose-content text-body leading-relaxed">
      <Content />
    </div>
    <div class="mt-10 pt-6 border-t border-line">
      <a href="/blog" class="text-accent underline text-sm">← Back to blog</a>
    </div>
  </article>
</Base>
