---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Financial Transparency — Base Impact', description: 'Base Impact financial information, budget, and transparency commitment.', ignoreTitleTemplate: true }}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="max-w-2xl">
      <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-gray-900 dark:text-white">Financial Transparency</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">
        Base Impact is committed to financial transparency and responsible stewardship of resources.
      </p>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Our commitment</h2>
      <ul class="mt-4 list-disc pl-5 space-y-2 text-gray-600 dark:text-slate-300">
        <li><strong>Open books</strong> — We will publish our budget and financial statements.</li>
        <li><strong>IRS compliance</strong> — Once 501(c)(3) status is granted, we will file IRS Form 990 annually and make it publicly available.</li>
        <li><strong>Donor stewardship</strong> — Donations will be tracked and reported transparently.</li>
        <li><strong>Board oversight</strong> — Our board of directors reviews and approves all financial decisions.</li>
      </ul>

      <h2 class="font-heading text-2xl font-semibold text-gray-900 dark:text-white mt-8">Current status</h2>
      <div class="mt-4 rounded-2xl bg-white dark:bg-slate-800 p-6 shadow-md border border-gray-100 dark:border-slate-700 space-y-2 text-sm">
        <p><strong>Organization type:</strong> Florida nonprofit corporation</p>
        <p><strong>IRS status:</strong> Pending 501(c)(3) approval</p>
        <p><strong>Location:</strong> Scottsmoor, Brevard County, FL</p>
      </div>
    </div>
  </section>
</Layout>
