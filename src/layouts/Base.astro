---
import '../styles/global.css';
import SiteShell from '../components/SiteShell.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title = 'Base Impact — Find Help',
  description = 'Find food, shelter, health, housing, and recovery resources. Technology help for communities.',
  canonical,
  ogImage = '/og-image.png',
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://baseimpact.org';
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang={Astro.currentLocale || 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted Inter — the Launchpad typeface -->
    <link rel="preload" href="/fonts/inter-v12-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-v12-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Base Impact" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Accessibility & Mobile -->
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d7ea3bbf897d40438db5374ed3dc46d7"}'></script>

    <!-- Service Worker -->
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NonprofitOrganization",
      "name": "Base Impact Inc.",
      "url": siteUrl,
      "description": "Technology help for Brevard County — devices, internet, and the skills to use them. Helping neighbors get connected and small nonprofits keep their technology working.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Scottsmoor",
        "addressRegion": "FL",
        "postalCode": "32775",
        "addressCountry": "US"
      },
      "telephone": "+1-321-323-0999",
      "email": "admin@baseimpact.org",
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": 28.7,
          "longitude": -80.9
        },
        "geoRadius": "50000"
      },
      "nonprofitStatus": "NonprofitTypeNotYetDetermined",
      "foundingLocation": {
        "@type": "Place",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Scottsmoor",
          "addressRegion": "FL",
          "addressCountry": "US"
        }
      }
    })} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-card focus:px-4 focus:py-2 focus:text-base focus:font-semibold focus:shadow-lg">Skip to main content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <SiteShell>
      <slot />
    </SiteShell>

    <!-- Modern motion layer: reveals, count-ups, scroll progress -->
    <script is:inline>
      // Reveal on scroll — IntersectionObserver (AOS-equivalent, no library).
      const revealEls = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && revealEls.length) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealEls.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('is-visible');
          else io.observe(el);
        });
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Count-up numbers. Run on load (staggered) rather than gating on
      // intersection — an observer that never fires would leave them stuck at 0.
      const easeOutQuart = (t) => 1 - Math.pow(1 - t, 4);
      const counters = document.querySelectorAll('[data-count-up]');
      const runCounter = (el) => {
        if (el.dataset.countDone === '1') return;
        el.dataset.countDone = '1';
        const target = parseFloat(el.getAttribute('data-count-up'));
        if (Number.isNaN(target)) return;
        const suffix = el.getAttribute('data-count-suffix') || '';
        const prefix = el.getAttribute('data-count-prefix') || '';
        const decimals = parseInt(el.getAttribute('data-count-decimals') || '0', 10);
        const duration = 1400;
        const startedAt = performance.now();
        const timer = setInterval(() => {
          // Timer-driven (not rAF) so the final value lands even when the tab
          // is backgrounded and requestAnimationFrame is suspended.
          const p = Math.min((performance.now() - startedAt) / duration, 1);
          el.textContent = prefix + (target * easeOutQuart(p)).toFixed(decimals) + suffix;
          if (p >= 1) clearInterval(timer);
        }, 30);
      };
      counters.forEach((el, index) => {
        setTimeout(() => runCounter(el), 400 + index * 220);
      });

      // Scroll progress bar
      const progress = document.querySelector('.scroll-progress');
      if (progress) {
        const update = () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>

    <!-- Fallback for no-JS: show all content -->
    <noscript>
      <style>
        [data-reveal], .fade-in, .stagger-children > * { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </body>
</html>
