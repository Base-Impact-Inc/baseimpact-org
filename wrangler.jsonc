{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "baseimpact-org",
	"account_id": "17e3d98243fa07749e75a8073a6b46ba",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "fbd1bc49ebdf4f4a88a75268c5d792bd"
		}
	],
	"d1_databases": [
		{
			"binding": "baseimpact_verify",
			"database_name": "baseimpact-verify",
			"database_id": "d60b0270-bc07-445f-b4fc-da0bcaa2af24",
			"migrations_dir": "../../migrations"
		}
	]
}
