{
  "name": "baseimpact-org",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:dump": "esbuild scripts/_dump-entry.ts --bundle --platform=node --format=cjs --outfile=.tmp-resources.cjs --log-level=error && node -e \"console.log(require('./.tmp-resources.cjs').ALL_RESOURCES.length)\"",
    "db:seed": "node scripts/seed-resources.mjs",
    "db:seed:local": "LOCAL=1 node scripts/seed-resources.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/sitemap": "^3.7.4",
    "@fullcalendar/core": "^7.1.5",
    "@fullcalendar/daygrid": "^6.1.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.11",
    "wrangler": "^4.161.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^7.0.2"
  },
  "description": "Open-source crisis resource directory & nonprofit tech platform for Brevard/Volusia/Orange counties, FL",
